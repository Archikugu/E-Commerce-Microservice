
@{
    ViewData["Title"] = "Index";
    Layout = "~/Areas/User/Views/Shared/_UserLayout.cshtml";
}

         
<div class="row">
    <div class="col-12 grid-margin">
        <div class="row">
            <div class="col-md-3 grid-margin stretch-card">
                <div class="card">
                    <div class="card-body" style="display:flex;align-items:center;gap:12px;">
                        <i class="mdi mdi-cart-outline" style="font-size:28px;color:#6366f1;"></i>
                        <div>
                            <p class="text-muted mb-0">Total Orders</p>
                            <h4 class="mb-0">@ViewBag.TotalOrders</h4>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3 grid-margin stretch-card">
                <div class="card">
                    <div class="card-body" style="display:flex;align-items:center;gap:12px;">
                        <i class="mdi mdi-truck-delivery" style="font-size:28px;color:#16a34a;"></i>
                        <div>
                            <p class="text-muted mb-0">Delivered</p>
                            <h4 class="mb-0">@ViewBag.DeliveredOrders</h4>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3 grid-margin stretch-card">
                <div class="card">
                    <div class="card-body" style="display:flex;align-items:center;gap:12px;">
                        <i class="mdi mdi-progress-clock" style="font-size:28px;color:#f59e0b;"></i>
                        <div>
                            <p class="text-muted mb-0">Processing</p>
                            <h4 class="mb-0">@ViewBag.ProcessingOrders</h4>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3 grid-margin stretch-card">
                <div class="card">
                    <div class="card-body" style="display:flex;align-items:center;gap:12px;">
                        <i class="mdi mdi-email-outline" style="font-size:28px;color:#ef4444;"></i>
                        <div>
                            <p class="text-muted mb-0">Unread Messages</p>
                            <h4 class="mb-0">@ViewBag.UnreadMessages</h4>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12 col-xl-6 grid-margin stretch-card">
        <div class="row w-100 flex-grow">
            <div class="col-md-12 grid-margin stretch-card">
                <div class="card">
                    <div class="card-body">
                        <p class="card-title">Orders (Last 7 days)</p>
                        <canvas id="audience-chart"></canvas>
                    </div>
                </div>
            </div>
            <div class="col-md-6 stretch-card">
                <div class="card">
                    <div class="card-body">
                        <div class="d-flex align-items-center justify-content-between flex-wrap">
                            <p class="card-title">Revenue (Last 7 days)</p>
                        </div>
                        <canvas id="balance-chart" height="130"></canvas>
                    </div>
                </div>
            </div>
            <div class="col-md-6 stretch-card">
                <div class="card">
                    <div class="card-body">
                        <div class="d-flex align-items-center justify-content-between flex-wrap">
                            <p class="card-title">Status Distribution</p>
                        </div>
                        <canvas id="task-chart" height="130"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-xl-6 grid-margin stretch-card">
        <div class="row w-100 flex-grow">
            <div class="col-md-6 grid-margin stretch-card">
                <div class="card">
                    <div class="card-body">
                        <p class="card-title">Wishlist</p>
                        <p class="text-muted">Items you saved</p>
                        
                        <div style="display:flex;align-items:flex-start;gap:16px;">
                            <i class="mdi mdi-heart-outline" style="font-size:32px;color:#ef4444;margin-top:2px;"></i>
                            <div style="flex:1;">
                                <div style="display:flex;align-items:baseline;gap:10px;">
                                    <h3 class="mb-0" style="font-weight:700;">@ViewBag.WishlistCount</h3>
                                    <span class="text-muted">items</span>
                                </div>
                                @{
                                    var names = ViewBag.WishlistNames as System.Collections.Generic.List<string> ?? new System.Collections.Generic.List<string>();
                                }
                                @if (names.Any())
                                {
                                    <style>
                                        .wishlist-list { counter-reset: wl; list-style: none; margin-top:10px; padding-left:0; }
                                        .wishlist-list li { display:flex; align-items:center; margin-bottom:8px; font-size:15px; font-weight:600; color:#111827; }
                                        .wishlist-list li::before {
                                            counter-increment: wl; content: counter(wl);
                                            display:inline-flex; align-items:center; justify-content:center;
                                            width:28px; height:28px; border-radius:50%;
                                            background:#eef2ff; color:#3730a3; border:1px solid #c7d2fe;
                                            font-size:14px; font-weight:700; margin-right:10px;
                                        }
                                    </style>
                                    <ol class="wishlist-list">
                                        @for (int i = 0; i < names.Count; i++)
                                        {
                                            <li>@names[i]</li>
                                        }
                                    </ol>
                                    @if ((ViewBag.WishlistCount as int? ?? 0) > names.Count)
                                    {
                                        <div style="margin-top:4px;">
                                            <span class="badge" style="background:#eef2ff;color:#3730a3;border:1px solid #c7d2fe;padding:6px 10px;border-radius:9999px;font-size:13px;font-weight:600;">+@((ViewBag.WishlistCount as int?) - names.Count) more</span>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="text-muted" style="font-size:14px;margin-top:8px;">No items</div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-6 grid-margin stretch-card">
                <div class="card">
                    <div class="card-body pb-0">
                        <div class="d-flex align-items-center mb-4">
                            <p class="card-title mb-0 mr-1">Recent Orders</p>
                            <div class="badge badge-info badge-pill">@((ViewBag.RecentOrders as System.Collections.ICollection)?.Count ?? 0)</div>
                        </div>
                        <div class="d-flex flex-column pt-2">
                            @{
                                var rec = ViewBag.RecentOrders as System.Collections.Generic.List<MultiShop.WebUI.Dtos.OrderDtos.OrderOrderingDtos.ResultOrderingByUserIdDto> ?? new System.Collections.Generic.List<MultiShop.WebUI.Dtos.OrderDtos.OrderOrderingDtos.ResultOrderingByUserIdDto>();
                            }
                            @if (rec.Any())
                            {
                                foreach (var r in rec)
                                {
                                    var cls = (r.Status ?? "New").ToLowerInvariant() == "delivered" ? "badge-success" : ((r.Status ?? "").ToLowerInvariant()=="processing"?"badge-warning":"badge-secondary");
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <span>#@r.OrderingId</span>
                                        <span>@r.OrderDate.ToString("dd MMM")</span>
                                        <span class="badge @cls">@(r.Status ?? "New")</span>
                                    </div>
                                }
                            }
                            else
                            {
                                <span class="text-muted">No recent orders.</span>
                            }
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-12 stretch-card">
                <div class="card">
                    <div class="card-body pb-0">
                        <p class="card-title">Status by Day (Last 7)</p>
                    </div>
                    <canvas height="170" id="status-chart"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    (function(){
        try {
            var orders = @{
                var all = ViewBag.OrdersForCharts as System.Collections.Generic.List<MultiShop.WebUI.Dtos.OrderDtos.OrderOrderingDtos.ResultOrderingByUserIdDto>
                          ?? new System.Collections.Generic.List<MultiShop.WebUI.Dtos.OrderDtos.OrderOrderingDtos.ResultOrderingByUserIdDto>();
                var json = System.Text.Json.JsonSerializer.Serialize(all);
            }@Html.Raw(json);

            // Build last 7 days buckets
            var days = [];
            var counts = [];
            var revenue = [];
            var map = {};
            for (var i = 6; i >= 0; i--) {
                var d = new Date(); d.setDate(d.getDate() - i);
                var key = d.getFullYear()+"-"+(('0'+(d.getMonth()+1)).slice(-2))+"-"+(('0'+d.getDate()).slice(-2));
                days.push((d.getMonth()+1) + "/" + d.getDate());
                map[key] = { count: 0, total: 0 };
            }
            orders.forEach(function(o){
                if (!o || !o.OrderDate) return;
                var d = new Date(o.OrderDate);
                var key = d.getFullYear()+"-"+(('0'+(d.getMonth()+1)).slice(-2))+"-"+(('0'+d.getDate()).slice(-2));
                if (map[key]) {
                    map[key].count += 1;
                    var price = (typeof o.TotalPrice === 'number') ? o.TotalPrice : (o.TotalPrice?.value || 0);
                    map[key].total += price || 0;
                }
            });
            days.forEach(function(_, idx){
                var d = new Date(); d.setDate(d.getDate() - (6-idx));
                var key = d.getFullYear()+"-"+(('0'+(d.getMonth()+1)).slice(-2))+"-"+(('0'+d.getDate()).slice(-2));
                counts.push(map[key]?.count || 0);
                revenue.push(map[key]?.total || 0);
            });

            // Status distribution (overall)
            var statusCounts = { delivered:0, processing:0, shipped:0, other:0 };
            orders.forEach(function(o){
                var s = (o.Status || '').toLowerCase();
                if (s === 'delivered') statusCounts.delivered++;
                else if (s === 'processing') statusCounts.processing++;
                else if (s === 'shipped') statusCounts.shipped++;
                else statusCounts.other++;
            });

            // Status per day (last 7 days)
            var deliveredPerDay = [], processingPerDay = [], shippedPerDay = [], otherPerDay = [];
            days.forEach(function(_, idx){
                var d = new Date(); d.setDate(d.getDate() - (6-idx));
                var key = d.getFullYear()+"-"+(('0'+(d.getMonth()+1)).slice(-2))+"-"+(('0'+d.getDate()).slice(-2));
                var countsByStatus = { delivered:0, processing:0, shipped:0, other:0 };
                orders.forEach(function(o){
                    if (!o || !o.OrderDate) return;
                    var od = new Date(o.OrderDate);
                    var ok = od.getFullYear()+"-"+(('0'+(od.getMonth()+1)).slice(-2))+"-"+(('0'+od.getDate()).slice(-2));
                    if (ok === key){
                        var s = (o.Status || '').toLowerCase();
                        if (s === 'delivered') countsByStatus.delivered++;
                        else if (s === 'processing') countsByStatus.processing++;
                        else if (s === 'shipped') countsByStatus.shipped++;
                        else countsByStatus.other++;
                    }
                });
                deliveredPerDay.push(countsByStatus.delivered);
                processingPerDay.push(countsByStatus.processing);
                shippedPerDay.push(countsByStatus.shipped);
                otherPerDay.push(countsByStatus.other);
            });

            function destroyIfExists(canvas){
                if (!window.Chart || !canvas) return;
                try {
                    var inst = Chart.getChart ? Chart.getChart(canvas) : (canvas.__chartist || canvas._chartInstance || null);
                    if (inst && inst.destroy) inst.destroy();
                } catch(e) {}
            }

            if (window.Chart) {
                var ac = document.getElementById('audience-chart');
                if (ac) {
                    destroyIfExists(ac);
                    new Chart(ac.getContext('2d'), {
                        type: 'line',
                        data: { labels: days, datasets: [{ label: 'Orders', data: counts, borderColor: '#6366f1', backgroundColor: 'rgba(99,102,241,0.15)', tension: 0.3, fill: true }]},
                        options: { plugins:{ legend:{ display:false } }, scales:{ y:{ beginAtZero:true } } }
                    });
                }
                var bc = document.getElementById('balance-chart');
                if (bc) {
                    destroyIfExists(bc);
                    new Chart(bc.getContext('2d'), {
                        type: 'bar',
                        data: { labels: days, datasets: [{ label: 'Revenue', data: revenue, backgroundColor: '#16a34a' }]},
                        options: { plugins:{ legend:{ display:false } }, scales:{ y:{ beginAtZero:true } } }
                    });
                }
                var tc = document.getElementById('task-chart');
                if (tc) {
                    destroyIfExists(tc);
                    new Chart(tc.getContext('2d'), {
                        type: 'doughnut',
                        data: { labels: ['Delivered','Processing','Shipped','Other'], datasets: [{ data: [statusCounts.delivered, statusCounts.processing, statusCounts.shipped, statusCounts.other], backgroundColor: ['#16a34a','#f59e0b','#3b82f6','#9ca3af'] }]},
                        options: { plugins:{ legend:{ position:'bottom' } } }
                    });
                }

                // Optional: if regional/status canvases exist, render too
                var rc = document.getElementById('regional-chart');
                if (rc) {
                    destroyIfExists(rc);
                    new Chart(rc.getContext('2d'), {
                        type: 'pie',
                        data: { labels: ['Delivered','Processing','Shipped','Other'], datasets: [{ data: [statusCounts.delivered, statusCounts.processing, statusCounts.shipped, statusCounts.other], backgroundColor: ['#16a34a','#f59e0b','#3b82f6','#9ca3af'] }]},
                        options: { plugins:{ legend:{ position:'bottom' } } }
                    });
                }
                var sc = document.getElementById('status-chart');
                if (sc) {
                    destroyIfExists(sc);
                    new Chart(sc.getContext('2d'), {
                        type: 'bar',
                        data: {
                            labels: days,
                            datasets: [
                                { label:'Delivered', data: deliveredPerDay, backgroundColor:'#16a34a' },
                                { label:'Processing', data: processingPerDay, backgroundColor:'#f59e0b' },
                                { label:'Shipped', data: shippedPerDay, backgroundColor:'#3b82f6' },
                                { label:'Other', data: otherPerDay, backgroundColor:'#9ca3af' }
                            ]
                        },
                        options: { plugins:{ legend:{ position:'bottom' } }, scales:{ x:{ stacked:true }, y:{ stacked:true, beginAtZero:true } } }
                    });
                }
            }
        } catch (e) { /* silent */ }
    })();
</script>
}
