@model List<MultiShop.WebUI.Dtos.OrderDtos.OrderAddressDtos.ResultOrderAddressDto>
@{
    ViewData["Title"] = "My Addresses";
    Layout = "~/Areas/User/Views/Shared/_UserLayout.cshtml";
}

<section class="content container-fluid">
    <div class="row">
        <div class="col-md-12">
            <div class="chart-box" style="border-radius:8px; border:1px solid rgba(0,0,0,.08); padding:20px;">
                <div style="display:flex; justify-content:space-between; align-items:center;">
                    <h3 style="margin:0; font-weight:600;">My Addresses</h3>
                    <a asp-area="User" asp-controller="Address" asp-action="Create" class="btn btn-primary"><i class="fa fa-plus" style="margin-right:6px;"></i> Add New</a>
                </div>
                <div class="table-responsive" style="margin-top:12px;">
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Email</th>
                                <th>Phone</th>
                                <th>City/District</th>
                                <th>Address</th>
                                <th style="width:140px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Count > 0)
                            {
                                foreach (var a in Model)
                                {
                                    <tr>
                                        <td>@a.FirstName @a.LastName</td>
                                        <td>@a.Email</td>
                                        <td>@a.PhoneNumber</td>
                                        <td>@a.City / @a.District</td>
                                        <td>@a.AddressLine1 @a.AddressLine2</td>
                                        <td>
                                            <div class="btn-group btn-group-sm" role="group" aria-label="Address actions" style="white-space:nowrap;">
                                                <a asp-area="User" asp-controller="Address" asp-action="Edit" asp-route-id="@a.AddressId" class="btn btn-warning rounded" style="border-radius:16px;" title="Edit">
                                                    <i class="mdi mdi-pencil" style="margin-right:6px;"></i> Edit
                                                </a>
                                                <a asp-area="User" asp-controller="Address" asp-action="Delete" asp-route-id="@a.AddressId" class="btn btn-danger rounded" style="border-radius:16px; margin-left:6px;" onclick="return confirm('Delete this address?');" title="Delete">
                                                    <i class="mdi mdi-delete" style="margin-right:6px;"></i> Delete
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6" class="text-center text-muted" style="padding:32px;">No addresses yet</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</section>


