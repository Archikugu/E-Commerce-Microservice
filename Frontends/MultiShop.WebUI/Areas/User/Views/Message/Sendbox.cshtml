@using MultiShop.WebUI.Dtos.MessageDtos
@model List<ResultSendboxMessageDto>
@{
    ViewData["Title"] = "Sendbox";
    Layout = "~/Areas/User/Views/Shared/_UserLayout.cshtml";
}

<div class="row">
    <div class="col-lg-12 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <div class="d-flex align-items-start justify-content-between">
                    <div>
                        <h4 class="card-title mb-1">Sent Messages</h4>
                        <p class="card-description mb-2">Messages you have sent</p>
                    </div>
                    <form method="get" class="d-flex align-items-center" style="gap:8px;">
                        <input type="hidden" name="pageNumber" value="1" />
                        @{ var curSize = (int)(ViewBag.PageSize ?? 10); }
                        <div class="input-group">
                            <div class="input-group-prepend"><span class="input-group-text"><i class="mdi mdi-magnify"></i></span></div>
                            <input type="text" name="q" value="@((string)(ViewBag.Query ?? ""))" class="form-control" placeholder="Search subject or message..." />
                        </div>
                        <div class="input-group" style="max-width:180px;">
                            <div class="input-group-prepend"><span class="input-group-text"><i class="mdi mdi-format-list-numbered"></i></span></div>
                            <select name="pageSize" class="form-control">
                                <option value="5" selected="@(curSize==5?"selected":null)">5</option>
                                <option value="10" selected="@(curSize==10?"selected":null)">10</option>
                                <option value="25" selected="@(curSize==25?"selected":null)">25</option>
                                <option value="50" selected="@(curSize==50?"selected":null)">50</option>
                            </select>
                        </div>
                        <button class="btn btn-sm btn-primary" type="submit"><i class="mdi mdi-filter"></i> Apply</button>
                    </form>
                </div>
                <div class="table-responsive">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>To</th>
                                <th>Subject</th>
                                <th>Date</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                var index = 0;
                                foreach (var item in Model)
                                {
                                    index++;
                                    <tr id="srow-@item.MessageId">
                                        <td>@index</td>
                                        <td>@item.ReceiverId</td>
                                        <td>@item.Subject</td>
                                        <td>@item.MessageDate.ToString("dd MMM yyyy HH:mm")</td>
                                        <td>@(item.IsRead ? "Read" : "Unread")</td>
                                        <td>
                                            <button type="button" class="btn btn-sm btn-primary" onclick="toggleMsg('smsg-@item.MessageId')">View</button>
                                        </td>
                                    </tr>
                                    <tr id="smsg-@item.MessageId" style="display:none;">
                                        <td colspan="6">
                                            <div class="p-3" style="background:#f8f9fa;border-radius:8px;">
                                                <div class="d-flex justify-content-between align-items-center mb-2">
                                                    <strong>Message</strong>
                                                    <button type="button" class="btn btn-xs btn-outline-secondary" onclick="toggleMsg('smsg-@item.MessageId')">Close</button>
                                                </div>
                                                <div>@item.MessageDetail</div>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6">No sent messages found.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="d-flex justify-content-center mt-3">
                    <nav aria-label="Sendbox pagination">
                        <ul class="pagination pagination-sm">
                            @{
                                int pageNumber = (int)(ViewBag.PageNumber ?? 1);
                                int pageSize = (int)(ViewBag.PageSize ?? 10);
                                int totalItems = (int)(ViewBag.TotalItems ?? 0);
                                int totalPages = Math.Max(1, (int)Math.Ceiling((double)totalItems / Math.Max(1, pageSize)));
                                int prev = Math.Max(1, pageNumber - 1);
                                int next = Math.Min(totalPages, pageNumber + 1);
                                string q = (string)(ViewBag.Query ?? "");
                            }
                            <li class="page-item @(pageNumber==1?"disabled":null)"><a class="page-link" asp-area="User" asp-controller="Message" asp-action="Sendbox" asp-route-pageNumber="1" asp-route-pageSize="@pageSize" asp-route-q="@q">First</a></li>
                            <li class="page-item @(pageNumber==1?"disabled":null)"><a class="page-link" asp-area="User" asp-controller="Message" asp-action="Sendbox" asp-route-pageNumber="@prev" asp-route-pageSize="@pageSize" asp-route-q="@q">Prev</a></li>
                            @for (int i = Math.Max(1, pageNumber-2); i <= Math.Min(totalPages, pageNumber+2); i++)
                            {
                                <li class="page-item @(i==pageNumber?"active":null)"><a class="page-link" asp-area="User" asp-controller="Message" asp-action="Sendbox" asp-route-pageNumber="@i" asp-route-pageSize="@pageSize" asp-route-q="@q">@i</a></li>
                            }
                            <li class="page-item @(pageNumber==totalPages?"disabled":null)"><a class="page-link" asp-area="User" asp-controller="Message" asp-action="Sendbox" asp-route-pageNumber="@next" asp-route-pageSize="@pageSize" asp-route-q="@q">Next</a></li>
                            <li class="page-item @(pageNumber==totalPages?"disabled":null)"><a class="page-link" asp-area="User" asp-controller="Message" asp-action="Sendbox" asp-route-pageNumber="@totalPages" asp-route-pageSize="@pageSize" asp-route-q="@q">Last</a></li>
                        </ul>
                    </nav>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function toggleMsg(id) {
        var row = document.getElementById(id);
        if (!row) return;
        row.style.display = row.style.display === 'none' ? '' : 'none';
    }
</script>


