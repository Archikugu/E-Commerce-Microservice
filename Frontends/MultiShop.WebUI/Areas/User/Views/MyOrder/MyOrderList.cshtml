@using MultiShop.WebUI.Dtos.OrderDtos.OrderOrderingDtos
@model List<ResultOrderingByUserIdDto>
@{
ViewData["Title"] = "My Orders";
    Layout = "~/Areas/User/Views/Shared/_UserLayout.cshtml";
    var totalAmount = (Model?.Sum(x => x.TotalPrice)) ?? 0m;
}

<div class="row">
    <div class="col-12 grid-margin">
        <div class="card">
            <div class="card-body">
                <div class="mb-3">
                    <div class="d-flex align-items-start justify-content-between">
                        <div>
                            <h4 class="card-title mb-1">My Orders</h4>
                            <p class="card-description mb-2">Your recent orders listed below</p>
                        </div>
                        <span class="badge badge-outline-success align-self-start">Total: @totalAmount.ToString("C")</span>
                    </div>
                    <form method="get" class="filter-bar" style="background:#f8fafc; border:1px solid #e5e7eb; border-radius:10px; padding:10px;">
                        <input type="hidden" name="pageNumber" value="1" />
                        @{ var curSize = (int)(ViewBag.PageSize ?? 10); }
                        <div class="d-flex flex-wrap" style="gap:10px;">
                            <div class="input-group" style="max-width:220px;">
                                <div class="input-group-prepend"><span class="input-group-text"><i class="mdi mdi-filter"></i></span></div>
                                <select name="status" class="form-control">
                                    @{ var s = (string)(ViewBag.SelectedStatus ?? "All"); string[] statuses = new[]{"All","New","Processing","Shipped","Delivered","Cancelled"}; }
                                    @foreach (var st in statuses)
                                    {
                                        <option value="@st" selected="@(string.Equals(s, st, StringComparison.OrdinalIgnoreCase)?"selected":null)">@st</option>
                                    }
                                </select>
                            </div>

                            <div class="input-group" style="max-width:200px;">
                                <div class="input-group-prepend"><span class="input-group-text"><i class="mdi mdi-calendar"></i></span></div>
                                <input type="date" name="from" value="@ViewBag.From" class="form-control" placeholder="From" />
                            </div>

                            <div class="input-group" style="max-width:200px;">
                                <div class="input-group-prepend"><span class="input-group-text"><i class="mdi mdi-calendar"></i></span></div>
                                <input type="date" name="to" value="@ViewBag.To" class="form-control" placeholder="To" />
                            </div>

                            <div class="input-group" style="max-width:200px; white-space:nowrap;">
                                <div class="input-group-prepend"><span class="input-group-text"><i class="mdi mdi-format-list-numbered"></i></span></div>
                                <select name="pageSize" class="form-control" style="min-width:90px;">
                                    <option value="5" selected="@(curSize==5?"selected":null)">5</option>
                                    <option value="10" selected="@(curSize==10?"selected":null)">10</option>
                                    <option value="25" selected="@(curSize==25?"selected":null)">25</option>
                                    <option value="50" selected="@(curSize==50?"selected":null)">50</option>
                                </select>
                                <div class="input-group-append"><span class="input-group-text">/ page</span></div>
                            </div>

                            <div class="ml-auto" style="display:flex; gap:8px;">
                                <a asp-area="User" asp-controller="MyOrder" asp-action="MyOrderList" class="btn btn-light btn-sm"><i class="mdi mdi-autorenew"></i> Clear</a>
                                <button type="submit" class="btn btn-primary btn-sm"><i class="mdi mdi-filter"></i> Apply</button>
                            </div>
                        </div>
                    </form>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover align-middle" id="ordersTable">
                        <thead class="thead-light">
                            <tr>
                                <th style="width:120px;">Order ID</th>
                                <th style="width:180px;" class="text-right">Total Price</th>
                                <th style="width:180px;">Status</th>
                                <th style="width:220px;">Order Date</th>
                                <th style="width:160px;">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                foreach (var item in Model.OrderByDescending(o => o.OrderDate))
                                {
                                    <tr>
                                        <td>
                                            <span class="badge badge-inverse-primary">#@item.OrderingId</span>
                                        </td>
                                        <td class="text-right">@item.TotalPrice.ToString("C")</td>
                                        <td>
                                            @{ var statusClass = (item.Status ?? "New").ToLowerInvariant() switch {
                                                "processing" => "badge-warning",
                                                "shipped" => "badge-info",
                                                "delivered" => "badge-success",
                                                "cancelled" => "badge-danger",
                                                _ => "badge-secondary"
                                            }; }
                                            <span class="badge @statusClass">@(item.Status ?? "New")</span>
                                        </td>
                                        <td>@item.OrderDate.ToString("dd MMM yyyy, HH:mm")</td>
                                        <td>
                                            <div class="btn-group btn-group-sm" role="group">
                                                <a href="/User/MyOrder/Detail/@item.OrderingId" class="btn btn-warning">
                                                    <i class="mdi mdi-file-document"></i> Details
                                                </a>
                                                @if (string.Equals(item.Status, "Delivered", StringComparison.OrdinalIgnoreCase))
                                                {
                                                    <a href="/User/Invoice/Detail/@item.OrderingId" class="btn btn-primary">
                                                        <i class="mdi mdi-file-pdf"></i> Invoice
                                                    </a>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center text-muted">No orders found.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="d-flex justify-content-center mt-3">
                    <nav aria-label="Orders pagination">
                        <ul class="pagination pagination-sm">
                            @{
                                int pageNumber = (int)(ViewBag.PageNumber ?? 1);
                                int pageSize = (int)(ViewBag.PageSize ?? 10);
                                int totalItems = (int)(ViewBag.TotalItems ?? 0);
                                int totalPages = Math.Max(1, (int)Math.Ceiling((double)totalItems / Math.Max(1, pageSize)));
                                int prev = Math.Max(1, pageNumber - 1);
                                int next = Math.Min(totalPages, pageNumber + 1);
                                string statusVal = (string)(ViewBag.SelectedStatus ?? "All");
                                string fv = (string)(ViewBag.From ?? "");
                                string tv = (string)(ViewBag.To ?? "");
                            }
                            <li class="page-item @(pageNumber==1?"disabled":null)"><a class="page-link" asp-area="User" asp-controller="MyOrder" asp-action="MyOrderList" asp-route-pageNumber="1" asp-route-pageSize="@pageSize" asp-route-status="@statusVal" asp-route-from="@fv" asp-route-to="@tv">First</a></li>
                            <li class="page-item @(pageNumber==1?"disabled":null)"><a class="page-link" asp-area="User" asp-controller="MyOrder" asp-action="MyOrderList" asp-route-pageNumber="@prev" asp-route-pageSize="@pageSize" asp-route-status="@statusVal" asp-route-from="@fv" asp-route-to="@tv">Prev</a></li>
                            @for (int i = Math.Max(1, pageNumber-2); i <= Math.Min(totalPages, pageNumber+2); i++)
                            {
                                <li class="page-item @(i==pageNumber?"active":null)"><a class="page-link" asp-area="User" asp-controller="MyOrder" asp-action="MyOrderList" asp-route-pageNumber="@i" asp-route-pageSize="@pageSize" asp-route-status="@statusVal" asp-route-from="@fv" asp-route-to="@tv">@i</a></li>
                            }
                            <li class="page-item @(pageNumber==totalPages?"disabled":null)"><a class="page-link" asp-area="User" asp-controller="MyOrder" asp-action="MyOrderList" asp-route-pageNumber="@next" asp-route-pageSize="@pageSize" asp-route-status="@statusVal" asp-route-from="@fv" asp-route-to="@tv">Next</a></li>
                            <li class="page-item @(pageNumber==totalPages?"disabled":null)"><a class="page-link" asp-area="User" asp-controller="MyOrder" asp-action="MyOrderList" asp-route-pageNumber="@totalPages" asp-route-pageSize="@pageSize" asp-route-status="@statusVal" asp-route-from="@fv" asp-route-to="@tv">Last</a></li>
                        </ul>
                    </nav>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function(){
            var input = document.getElementById('orderSearch');
            var table = document.getElementById('ordersTable');
            if(!input || !table) return;
            input.addEventListener('input', function(){
                var q = (this.value || '').toLowerCase();
                var rows = table.querySelectorAll('tbody tr');
                rows.forEach(function(r){
                    var txt = r.textContent.toLowerCase();
                    r.style.display = txt.indexOf(q) >= 0 ? '' : 'none';
                });
            });
        })();
    </script>
}

