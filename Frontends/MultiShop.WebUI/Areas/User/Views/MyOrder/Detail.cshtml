@using MultiShop.WebUI.Dtos.OrderDtos.OrderDetailDtos
@model List<ResultOrderDetailDto>
@{
    ViewData["Title"] = "Order Details";
    Layout = "~/Areas/User/Views/Shared/_UserLayout.cshtml";
}

<div class="container-fluid">
    <div class="row px-xl-5">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4 class="mb-0">Order #@ViewBag.OrderingId</h4>
                <a class="btn btn-outline-primary" href="/User/MyOrder/MyOrderList" style="border-radius:10px;">Back to My Orders</a>
            </div>
            <div class="table-responsive">
                <table class="table table-bordered text-center mb-0">
                    <thead class="bg-secondary text-dark">
                        <tr>
                            <th>Product</th>
                            <th>Price</th>
                            <th>Quantity</th>
                            <th>Total</th>
                        </tr>
                    </thead>
                    <tbody class="align-middle">
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td class="align-middle text-left">@item.ProductName</td>
                                    <td class="align-middle">@item.ProductPrice.ToString("C2")</td>
                                    <td class="align-middle">@item.ProductAmount</td>
                                    <td class="align-middle">@item.ProductTotalPrice.ToString("C2")</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center">No order items found.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>


