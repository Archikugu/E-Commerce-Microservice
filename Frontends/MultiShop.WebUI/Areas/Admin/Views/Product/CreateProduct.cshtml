@model CreateProductDto
@{
	ViewData["Title"] = "CreateProduct";
	Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<section class="content container-fluid">
	<div class="row">

        <div class="col-md-12">
            <div class="chart-box">
                <style>
                    .chart-box{ border-radius:8px; border:1px solid rgba(0,0,0,.08); overflow:hidden; }
                    .page-header { display:flex; align-items:center; justify-content:space-between; margin:0 0 12px 0; }
                    .page-header h4 { margin:0; font-weight:600; }
                    .form-group{ margin-bottom:12px; }
                    .form-control{ border-radius:8px; border:1px solid rgba(0,0,0,.15); box-shadow:none; }
                    .form-control:focus{ border-color:#0d6efd; box-shadow:0 0 0 .1rem rgba(13,110,253,.15); }
                    .btn-add{ background:#198754; border-color:#198754; color:#fff; border-radius:20px; padding:8px 14px; transition:all .15s ease; box-shadow:0 2px 6px rgba(25,135,84,.18); }
                    .btn-add:hover{ background:#157347; border-color:#157347; color:#fff; box-shadow:0 6px 16px rgba(25,135,84,.35); transform: translateY(-1px); text-decoration:none; }
                    .btn-cancel{ border-radius:20px; padding:8px 14px; }
                </style>
                <div class="page-header">
                    <h4>Product Creation Page</h4>
                    <a asp-area="Admin" asp-controller="Product" asp-action="Index" class="btn btn-default btn-cancel"><i class="fa fa-arrow-left"></i> Back</a>
                </div>
                <div class="bs-example" data-example-id="bordered-table">

                    <form method="post">
                        <div class="form-group">
                            <label>Product Name</label>
                            <input type="text" class="form-control" asp-for="ProductName" />
                        </div>
                        <div class="form-group">
                            <label>Product Price</label>
                            <input type="text" class="form-control" asp-for="Price" />
                        </div>
                        <div class="form-group">
                            <label>Product Image</label>
                            <input type="hidden" asp-for="ImageUrl" />
                            <div class="custom-file" style="display:flex; align-items:center; gap:8px;">
                                <input type="file" id="productCreateImageFile" accept="image/*" style="display:none;" />
                                <label for="productCreateImageFile" class="btn btn-default btn-upload" style="border-radius:20px; padding:8px 14px; border:1px solid #0d6efd; color:#0d6efd; background:#fff; box-shadow:0 1px 2px rgba(13,110,253,.08);"><i class="fa fa-upload" style="margin-right:6px;"></i> Choose Image</label>
                                <span id="productCreateFileNameText" class="file-name" style="font-size:13px; color:#6c757d;">No file chosen</span>
                            </div>
                            <div class="preview-wrap" style="margin-top:8px;">
                                <img id="productCreateImagePreview" class="preview-img" alt="Preview" style="display:none; width:160px; height:120px; object-fit:cover; border-radius:8px; border:1px solid rgba(0,0,0,.1); box-shadow:0 2px 6px rgba(0,0,0,.06);" />
                            </div>
                            <div id="productCreateUploadError" class="alert alert-danger" style="display:none; margin-top:8px;"></div>
                        </div>
                        <div class="form-group">
                            <label>Product Categories</label>
                            @Html.DropDownListFor(x => x.CategoryId, (List<SelectListItem>)ViewBag.Categories, new { @style = "padding:0;", @class = "form-control" })
                        </div>
                        <div class="form-group" style="display:flex; gap:12px;">
                            <div style="flex:1;">
                                <label>Stock Quantity</label>
                                <input type="number" min="0" class="form-control" asp-for="StockQuantity" />
                            </div>
                            <div style="flex:1;">
                                <label>Min Stock</label>
                                <input type="number" min="0" class="form-control" asp-for="MinStock" />
                            </div>
                            <div style="flex:1;">
                                <label>Max Stock</label>
                                <input type="number" min="0" class="form-control" asp-for="MaxStock" />
                            </div>
                        </div>
                        <div class="form-group">
                            <label>Product Description</label>
                            <textarea class="form-control" asp-for="Description" rows="5"></textarea>
                        </div>
                        <div style="display:flex; align-items:center; gap:8px;">
                            <button class="btn btn-add"><i class="fa fa-save" style="margin-right:8px;"></i> Add Product</button>
                            <a asp-area="Admin" asp-controller="Product" asp-action="Index" class="btn btn-default btn-cancel">Cancel</a>
                        </div>
                        <script>
                            (function(){
                                var fileInput = document.getElementById('productCreateImageFile');
                                var fileNameText = document.getElementById('productCreateFileNameText');
                                var previewImg = document.getElementById('productCreateImagePreview');
                                var formEl = document.querySelector('form[method="post"]');
                                var submitBtns = formEl.querySelectorAll('button[type="submit"], .btn-add');
                                if (fileInput && fileNameText){
                                    fileInput.addEventListener('change', function(){
                                        var f = (fileInput.files && fileInput.files[0]) ? fileInput.files[0] : null;
                                        fileNameText.textContent = f ? f.name : 'No file chosen';
                                        if (previewImg){
                                            if (f){ previewImg.src = URL.createObjectURL(f); previewImg.style.display = 'inline-block'; }
                                            else { previewImg.removeAttribute('src'); previewImg.style.display = 'none'; }
                                        }
                                    });
                                }
                                function handleSubmit(e){
                                    var errBox = document.getElementById('productCreateUploadError');
                                    if (errBox) { errBox.style.display = 'none'; errBox.textContent = ''; }
                                    var file = fileInput && fileInput.files && fileInput.files[0];
                                    if(!file){ return true; }
                                    e.preventDefault();
                                    var btn = e.currentTarget;
                                    btn.disabled = true; var originalText = btn.innerHTML; btn.innerHTML = '<i class="fa fa-spinner fa-spin"></i> Uploading...';
                                    var data = new FormData();
                                    data.append('file', file);
                                    fetch('/Admin/Product/UploadImage', { method:'POST', body:data })
                                        .then(function(r){ return r.ok ? r.json() : r.text().then(function(t){ throw new Error(t || ('HTTP '+r.status)); }); })
                                        .then(function(res){
                                            var p = Promise.resolve(null);
                                            if (res && res.fileName){
                                                p = fetch('/Admin/Product/GetSignedUrl?fileName='+encodeURIComponent(res.fileName)+'&minutes=10080')
                                                    .then(function(r){ return r.ok ? r.json() : null; })
                                                    .catch(function(){ return null; });
                                            }
                                            return p.then(function(signed){
                                                var imageInput = document.querySelector('input[name="ImageUrl"]');
                                                if (imageInput){
                                                    if (signed && signed.signedUrl){ imageInput.value = signed.signedUrl; }
                                                    else if(res && res.url){ imageInput.value = res.url; }
                                                }
                                                formEl.submit();
                                            });
                                        })
                                        .catch(function(e){
                                            if (errBox) { errBox.textContent = 'Image upload failed. '+ (e && e.message ? e.message : ''); errBox.style.display = 'block'; }
                                            btn.disabled = false; btn.innerHTML = originalText;
                                        });
                                }
                                submitBtns.forEach(function(b){ b.addEventListener('click', handleSubmit); });
                            })();
                        </script>
                    </form>

                </div>
            </div>
        </div>
	</div>
</section>

