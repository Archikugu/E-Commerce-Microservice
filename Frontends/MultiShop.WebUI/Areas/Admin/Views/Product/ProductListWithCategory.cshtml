@model List<ResultProductsWithCategoryDto>

@{
	ViewData["Title"] = "ProductListWithCategory";
	Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
	int count = 0;
}

<section class="content container-fluid">
	<div class="row">
		<div class="col-md-12">
			<div class="chart-box">
				<style>
					.chart-box{ border-radius:8px; border:1px solid rgba(0,0,0,.08); overflow:hidden; }
					.page-header { display:flex; align-items:center; justify-content:space-between; margin:0 0 12px 0; }
					.page-header h4 { margin:0; font-weight:600; }
					.table .btn { border-radius:16px; padding:6px 10px; }
					.btn-update{ background:#ffc107; border-color:#ffc107; color:#212529; }
					.btn-delete{ background:#dc3545; border-color:#dc3545; color:#fff; }
					.btn-info{ background:#0dcaf0; border-color:#0dcaf0; color:#fff; }
					.btn-secondary{ border-radius:16px; }
					.table > thead > tr > th,
					.table > tbody > tr > th,
					.table > tbody > tr > td { vertical-align: middle; }
				</style>
				<div class="page-header">
					<h4>Product List With Category</h4>
				</div>
				<div class="bs-example" data-example-id="simple-table">
					<table class="table table-striped table-hover">
						<thead>
							<tr>
								<th>#</th>
								<th>Product Name</th>
								<th>Price</th>
								<th>Product Category</th>
								<th>Delete</th>
								<th>Update</th>
								<th>Product Images</th>
								<th>Product Description an Info</th>
							</tr>
						</thead>
						<tbody>
							@foreach (var item in Model)
							{
								count++;
								<tr>
									<th scope="row">@count</th>
									<td>@item.ProductName</td>
									<td>@item.Price</td>
									<td>@item.Category.CategoryName</td>
						<td><a asp-area="Admin" asp-controller="Product" asp-action="DeleteProduct" asp-route-id="@item.ProductId" class="btn btn-delete btn-sm"><i class="fa fa-trash"></i> Delete</a></td>
						<td><a asp-area="Admin" asp-controller="Product" asp-action="UpdateProduct" asp-route-id="@item.ProductId" class="btn btn-update btn-sm"><i class="fa fa-edit"></i> Update</a></td>
						<td><a asp-area="Admin" asp-controller="ProductImage" asp-action="ProductImages" asp-route-id="@item.ProductId" class="btn btn-info btn-sm"><i class="fa fa-image"></i> Product Images</a></td>
						<td><a asp-area="Admin" asp-controller="ProductDetail" asp-action="GetByIdProductDetail" asp-route-id="@item.ProductId" class="btn btn-secondary btn-sm"><i class="fa fa-info-circle"></i> Product Description</a></td>
								</tr>
							}
						</tbody>
					</table>

					<a asp-area="Admin" asp-controller="Product" asp-action="CreateProduct" class="btn btn-add"><i class="fa fa-plus" style="margin-right:8px;"></i> Add New Product</a>
				</div>
			</div>
		</div>
	</div>
</section>
