@using MultiShop.WebUI.Dtos.CatalogDtos.FeatureDtos
@model CreateFeatureDto

@{
	ViewData["Title"] = "CreateFeature";
	Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}


<section class="content container-fluid">
	<div class="row">

		<div class="col-md-12">
			<div class="chart-box">
				<style>
					.chart-box{ border-radius:8px; border:1px solid rgba(0,0,0,.08); overflow:hidden; }
					.page-header { display:flex; align-items:center; justify-content:space-between; margin:0 0 12px 0; }
					.page-header h4 { margin:0; font-weight:600; }
					.form-group{ margin-bottom:12px; }
					.form-control{ border-radius:8px; border:1px solid rgba(0,0,0,.15); box-shadow:none; }
					.form-control:focus{ border-color:#0d6efd; box-shadow:0 0 0 .1rem rgba(13,110,253,.15); }
					.btn-add{ background:#198754; border-color:#198754; color:#fff; border-radius:20px; padding:8px 14px; transition:all .15s ease; box-shadow:0 2px 6px rgba(25,135,84,.18); }
					.btn-add:hover{ background:#157347; border-color:#157347; color:#fff; box-shadow:0 6px 16px rgba(25,135,84,.35); transform: translateY(-1px); text-decoration:none; }
					.btn-cancel{ border-radius:20px; padding:8px 14px; }
					.help-text{ font-size:12px; color:#6c757d; }
				</style>

				<div class="page-header">
					<h4>Create New Feature</h4>
					<a asp-area="Admin" asp-controller="Feature" asp-action="Index" class="btn btn-default btn-cancel"><i class="fa fa-arrow-left"></i> Back</a>
				</div>

				<div class="bs-example" data-example-id="bordered-table">
					@Html.ValidationSummary(false, "", new { @class = "text-danger" })
					<form method="post" id="featureCreateForm">
						@Html.AntiForgeryToken()
						<div class="form-group">
							<label for="Title">Feature Title</label>
							<input type="text" class="form-control" asp-for="Title" placeholder="e.g. Free Shipping" required />
							<span asp-validation-for="Title" class="text-danger"></span>
						</div>
						<div class="form-group">
							<label for="Icon">Feature Icon</label>
							<input type="text" class="form-control" asp-for="Icon" placeholder="e.g. fa fa-truck" />
							<span class="help-text">Use a Font Awesome class or relevant icon key.</span>
							<span asp-validation-for="Icon" class="text-danger"></span>
						</div>

						<div style="display:flex; align-items:center; gap:8px;">
							<button type="submit" class="btn btn-add"><i class="fa fa-plus" style="margin-right:8px;"></i> Add Feature</button>
							<a asp-area="Admin" asp-controller="Feature" asp-action="Index" class="btn btn-default btn-cancel">Cancel</a>
						</div>
					</form>
				</div>
			</div>
		</div>
	</div>
</section>
