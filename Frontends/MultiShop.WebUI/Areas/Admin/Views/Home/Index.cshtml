					<h5>Valid Coupons</h5>
					<h3>@ViewBag.ValidCoupons</h3>
				</div>
			</div>
		</div>
	</div>

	<div class="row">
		<div class="col-lg-7">
			<div class="chart-box" style="background:#fff;border-radius:10px;box-shadow:0 2px 8px rgba(16,24,40,.08);padding:16px;">
				<h4>Cheapest & Most Expensive Products</h4>
				<div class="table-responsive">
					<table class="table table-striped table-bordered table-hover">
						<thead class="bg-info">
							<tr>
								<th>Type</th>
								<th>Product</th>
								<th class="text-right">Price</th>
							</tr>
						</thead>
						<tbody>
							@if (ViewBag.CheapestProduct != null)
							{
								<tr class="table-success">
									<td>Cheapest</td>
									<td>@ViewBag.CheapestProduct.ProductName</td>
									<td class="text-right">@(((decimal)ViewBag.CheapestProduct.Price).ToString("C"))</td>
								</tr>
							}
							else
							{
								<tr class="table-success">
									<td>Cheapest</td>
									<td colspan="2" class="text-muted">No product</td>
								</tr>
							}

							@if (ViewBag.MostExpensiveProduct != null)
							{
								<tr class="table-danger">
									<td>Most Expensive</td>
									<td>@ViewBag.MostExpensiveProduct.ProductName</td>
									<td class="text-right">@(((decimal)ViewBag.MostExpensiveProduct.Price).ToString("C"))</td>
								</tr>
							}
							else
							{
								<tr class="table-danger">
									<td>Most Expensive</td>
									<td colspan="2" class="text-muted">No product</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			</div>
		</div>
