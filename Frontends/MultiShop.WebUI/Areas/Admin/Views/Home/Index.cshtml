						<div class="panel-body" style="background:#ffffff;border:1px solid #e6eaf2;border-radius:12px;padding:12px;box-shadow:0 2px 8px rgba(16,24,40,.06);">
							<div class="row">
									<div class="col-md-5" style="display:flex;align-items:center;justify-content:center;">
                                    @{
                                        var todayClass = "text-warning";
                                        double todayVal = 0;
                                        try { todayVal = System.Convert.ToDouble(ViewBag.Weather, System.Globalization.CultureInfo.InvariantCulture); } catch { todayVal = 0; }
                                        if (todayVal >= 30) todayClass = "text-danger";
                                        else if (todayVal >= 20) todayClass = "text-warning";
                                        else if (todayVal >= 10) todayClass = "text-primary";
                                        else todayClass = "text-info";
                                    }
										<div style="width:100%;max-width:380px;margin:0 auto;background:#f7f9fc;border:1px solid #e6eaf2;border-radius:12px;padding:16px 20px;display:flex;align-items:center;justify-content:center;gap:16px;text-align:center;">
											<div style="width:60px;height:60px;border-radius:50%;background:#eef3ff;display:flex;align-items:center;justify-content:center;">
												<div class="wi wi-day-snow @todayClass" style="font-size:28px;"></div>
											</div>
											<div style="display:flex;flex-direction:column;line-height:1;align-items:center;">
												<span class="text-uppercase text-muted" style="font-weight:700;letter-spacing:.6px;margin-bottom:6px;">Today</span>
												<span class="@todayClass" style="font-weight:800;font-size:36px;">@(ViewBag.Weather != null ? ($"{ViewBag.Weather} °C") : "-")</span>
											</div>
										</div>
									</div>
								<div class="col-md-7">
									<div class="row">
										@{
											var days = ViewBag.Days as System.Collections.Generic.List<string> ?? new System.Collections.Generic.List<string>();
											var icons = ViewBag.ForecastIcons as System.Collections.Generic.List<string> ?? new System.Collections.Generic.List<string>();
										}
										@{
											var temps = ViewBag.ForecastTemps as System.Collections.Generic.List<string> ?? new System.Collections.Generic.List<string>();
										}
										<div class="col-md-12" style="margin:6px 0 10px 0;">
											<p class="text-uppercase text-muted" style="letter-spacing:0.5px;font-weight:600;">Next 6 Days</p>
										</div>
                                        @for (int i = 0; i < 6; i++)
                                        {
                                            var dayLabel = days.Count > i ? days[i] : "-";
                                            var tempLabel = temps.Count > i ? temps[i] : "-";
                                            int tVal;
                                            bool ok = int.TryParse(tempLabel, System.Globalization.NumberStyles.Integer, System.Globalization.CultureInfo.InvariantCulture, out tVal);
                                            var cardBg = "#f7f9fc";
                                            var iconCol = "text-indigo";
                                            if (ok)
                                            {
                                                if (tVal >= 30) { cardBg = "#ffe5e5"; iconCol = "text-danger"; }
                                                else if (tVal >= 20) { cardBg = "#fff3cd"; iconCol = "text-warning"; }
                                                else if (tVal >= 10) { cardBg = "#e7f1ff"; iconCol = "text-primary"; }
                                                else { cardBg = "#e5f7ff"; iconCol = "text-info"; }
                                            }
											<div class="col-md-2 col-xs-4">
													<div class="text-center" style="background:@cardBg;border:1px solid #e6eaf2;border-radius:8px;padding:8px 6px;margin-bottom:8px;">
													<p class="text-uppercase" style="margin-bottom:6px;font-weight:600;">@dayLabel</p>
														<div class="@((icons.Count > i ? icons[i] : "wi wi-day-cloudy")) font-18 @iconCol" style="margin:4px 0 6px 0;"></div>
													<div class="wi-small weather-cent"><span>@(tempLabel == "-" ? "-" : ($"{tempLabel} °C"))</span></div>
												</div>
											</div>
										}
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
