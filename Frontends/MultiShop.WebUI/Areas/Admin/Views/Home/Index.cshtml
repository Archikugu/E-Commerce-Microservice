@{
	ViewData["Title"] = "Admin Dashboard";
	Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">
	<div class="row" style="margin-bottom:12px;">
	</div>
	<div class="row">
		<!-- Order Statistics Section -->
		<div class="col-lg-3 col-xs-6">
            <div class="media-box" style="background:linear-gradient(135deg,#8b5cf6,#a78bfa);color:#fff;border-radius:10px;box-shadow:0 2px 8px rgba(16,24,40,.12);">
                <div class="media-icon pull-left"><i class="fa fa-shopping-bag"></i> </div>
				<div class="media-info">
					<h5>Total Orders</h5>
					<h3>@ViewBag.TotalOrders</h3>
				</div>
			</div>
		</div>
		<div class="col-lg-3 col-xs-6">
            <div class="media-box" style="background:linear-gradient(135deg,#10b981,#34d399);color:#fff;border-radius:10px;box-shadow:0 2px 8px rgba(16,24,40,.12);">
                <div class="media-icon pull-left"><i class="fa fa-dollar"></i> </div>
				<div class="media-info">
					<h5>Total Revenue</h5>
					<h3>@ViewBag.TotalRevenue?.ToString("C")</h3>
				</div>
			</div>
		</div>
		<div class="col-lg-3 col-xs-6">
            <div class="media-box" style="background:linear-gradient(135deg,#f59e0b,#fbbf24);color:#fff;border-radius:10px;box-shadow:0 2px 8px rgba(16,24,40,.12);">
                <div class="media-icon pull-left"><i class="fa fa-calendar-day"></i> </div>
				<div class="media-info">
					<h5>Today's Revenue</h5>
					<h3>@ViewBag.TodayRevenue?.ToString("C")</h3>
				</div>
			</div>
		</div>
		<div class="col-lg-3 col-xs-6">
            <div class="media-box" style="background:linear-gradient(135deg,#ef4444,#f87171);color:#fff;border-radius:10px;box-shadow:0 2px 8px rgba(16,24,40,.12);">
                <div class="media-icon pull-left"><i class="fa fa-clock"></i> </div>
				<div class="media-info">
					<h5>Pending Orders</h5>
					<h3>@ViewBag.PendingOrders</h3>
				</div>
			</div>
		</div>
	</div>
	<div class="row">
        <div class="col-lg-3 col-xs-6">
            <div class="media-box" style="background:linear-gradient(135deg,#4f46e5,#6366f1);color:#fff;border-radius:10px;box-shadow:0 2px 8px rgba(16,24,40,.12);">
                <div class="media-icon pull-left"><i class="fa fa-tags"></i> </div>
				<div class="media-info">
					<h5>Category Count</h5>
					<h3>@ViewBag.CategoryCount</h3>
				</div>
			</div>
		</div>
		<div class="col-lg-3 col-xs-6">
            <div class="media-box bg-sea" style="background:linear-gradient(135deg,#0ea5e9,#22d3ee);color:#fff;border-radius:10px;box-shadow:0 2px 8px rgba(16,24,40,.12);">
                <div class="media-icon pull-left"><i class="fa fa-credit-card"></i> </div>
				<div class="media-info">
					<h5>Average Product Price</h5>
					<h3>@ViewBag.AverageProductPrice</h3>
				</div>
			</div>
		</div>
		<div class="col-lg-3 col-xs-6">
            <div class="media-box bg-blue" style="background:linear-gradient(135deg,#2563eb,#3b82f6);color:#fff;border-radius:10px;box-shadow:0 2px 8px rgba(16,24,40,.12);">
                <div class="media-icon pull-left"><i class="fa fa-cubes"></i> </div>
				<div class="media-info">
					<h5>Product Count</h5>
					<h3>@ViewBag.ProductCount</h3>
				</div>
			</div>
		</div>
		<div class="col-lg-3 col-xs-6">
            <div class="media-box bg-green" style="background:linear-gradient(135deg,#16a34a,#22c55e);color:#fff;border-radius:10px;box-shadow:0 2px 8px rgba(16,24,40,.12);">
                <div class="media-icon pull-left"><i class="fa fa-briefcase"></i> </div>
				<div class="media-info">
					<h5>Brand Count</h5>
					<h3>@ViewBag.BrandCount</h3>
				</div>
			</div>
		</div>
		<div class="col-lg-3 col-xs-6">
            <div class="media-box bg-purple" style="background:linear-gradient(135deg,#7e22ce,#a855f7);color:#fff;border-radius:10px;box-shadow:0 2px 8px rgba(16,24,40,.12);">
                <div class="media-icon pull-left"><i class="fa fa-users"></i> </div>
				<div class="media-info">
					<h5>User Count</h5>
					<h3>@ViewBag.UserCount</h3>
				</div>
			</div>
		</div>
		<div class="col-lg-3 col-xs-6">
            <div class="media-box bg-success" style="background:linear-gradient(135deg,#059669,#10b981);color:#fff;border-radius:10px;box-shadow:0 2px 8px rgba(16,24,40,.12);">
                <div class="media-icon pull-left"><i class="fa fa-comments"></i> </div>
				<div class="media-info">
					<h5>Active Comments</h5>
					<h3>@ViewBag.ActiveCommentCount</h3>
				</div>
			</div>
		</div>
		<div class="col-lg-3 col-xs-6">
            <div class="media-box bg-warning" style="background:linear-gradient(135deg,#eab308,#f59e0b);color:#fff;border-radius:10px;box-shadow:0 2px 8px rgba(16,24,40,.12);">
                <div class="media-icon pull-left"><i class="fa fa-comments-o"></i> </div>
				<div class="media-info">
					<h5>Passive Comments</h5>
					<h3>@ViewBag.PassiveCommentCount</h3>
				</div>
			</div>
		</div>
		<div class="col-lg-3 col-xs-6">
            <div class="media-box bg-danger" style="background:linear-gradient(135deg,#dc2626,#ef4444);color:#fff;border-radius:10px;box-shadow:0 2px 8px rgba(16,24,40,.12);">
                <div class="media-icon pull-left"><i class="fa fa-comment"></i> </div>
				<div class="media-info">
					<h5>Total Comments</h5>
					<h3>@ViewBag.TotalCommentCount</h3>
				</div>
			</div>
		</div>
		<div class="col-lg-3 col-xs-6">
            <div class="media-box bg-indigo" style="background:linear-gradient(135deg,#4338ca,#6366f1);color:#fff;border-radius:10px;box-shadow:0 2px 8px rgba(16,24,40,.12);">
                <div class="media-icon pull-left"><i class="fa fa-ticket"></i> </div>
				<div class="media-info">
					<h5>Total Coupons</h5>
					<h3>@ViewBag.TotalCoupons</h3>
				</div>
			</div>
		</div>
		<div class="col-lg-3 col-xs-6">
            <div class="media-box bg-success" style="background:linear-gradient(135deg,#0f766e,#14b8a6);color:#fff;border-radius:10px;box-shadow:0 2px 8px rgba(16,24,40,.12);">
                <div class="media-icon pull-left"><i class="fa fa-check-circle"></i> </div>
				<div class="media-info">
					<h5>Active Coupons</h5>
					<h3>@ViewBag.ActiveCoupons</h3>
				</div>
			</div>
		</div>
		<div class="col-lg-3 col-xs-6">
            <div class="media-box bg-warning" style="background:linear-gradient(135deg,#f59e0b,#f97316);color:#fff;border-radius:10px;box-shadow:0 2px 8px rgba(16,24,40,.12);">
                <div class="media-icon pull-left"><i class="fa fa-ban"></i> </div>
				<div class="media-info">
					<h5>Inactive Coupons</h5>
					<h3>@ViewBag.InactiveCoupons</h3>
				</div>
			</div>
		</div>
		<div class="col-lg-3 col-xs-6">
            <div class="media-box bg-danger" style="background:linear-gradient(135deg,#b91c1c,#ef4444);color:#fff;border-radius:10px;box-shadow:0 2px 8px rgba(16,24,40,.12);">
                <div class="media-icon pull-left"><i class="fa fa-times-circle"></i> </div>
				<div class="media-info">
					<h5>Expired Coupons</h5>
					<h3>@ViewBag.ExpiredCoupons</h3>
				</div>
			</div>
		</div>
		<div class="col-lg-3 col-xs-6">
            <div class="media-box bg-teal" style="background:linear-gradient(135deg,#0ea5e9,#22d3ee);color:#fff;border-radius:10px;box-shadow:0 2px 8px rgba(16,24,40,.12);">
                <div class="media-icon pull-left"><i class="fa fa-check"></i> </div>
				<div class="media-info">
					<h5>Valid Coupons</h5>
					<h3>@ViewBag.ValidCoupons</h3>
				</div>
			</div>
		</div>
	</div>

	<div class="row">
		<div class="col-lg-8">
			<div class="chart-box" style="background:#fff;border-radius:10px;box-shadow:0 2px 8px rgba(16,24,40,.08);padding:20px;">
				<h4 style="margin-bottom:20px;">Sales Overview</h4>
				<canvas id="salesChart" style="max-height:300px;"></canvas>
			</div>
		</div>
		<div class="col-lg-4">
			<div style="background:#fff;border-radius:10px;box-shadow:0 2px 8px rgba(16,24,40,.08);padding:20px;">
				<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:20px;">
					<h4 style="margin:0;">Order Status</h4>
					<div style="background:linear-gradient(135deg,#0ea5e9,#22d3ee);border-radius:8px;padding:8px 16px;color:#fff;font-size:12px;font-weight:600;">
						@{
							var todayClass = "text-white";
							double todayVal = 0;
							try { todayVal = System.Convert.ToDouble(ViewBag.Weather, System.Globalization.CultureInfo.InvariantCulture); } catch { todayVal = 0; }
						}
						<i class="wi wi-day-sunny" style="margin-right:6px;"></i>@(ViewBag.Weather != null ? $"{ViewBag.Weather}°C" : "-")
					</div>
				</div>
				<canvas id="statusChart" style="max-height:280px;"></canvas>
			</div>
		</div>
		<div class="col-lg-12">
			<div class="chart-box" style="background:#fff;border-radius:10px;box-shadow:0 2px 8px rgba(16,24,40,.08);padding:16px;">
				<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px;">
					<h4 style="margin:0;">Recent Orders</h4>
					<a asp-area="Admin" asp-controller="Order" asp-action="Index" class="btn btn-sm btn-primary">
						<i class="fa fa-arrow-right"></i> View All Orders
					</a>
				</div>
				<div class="table-responsive">
					<table class="table table-striped table-hover" style="margin-bottom:0;">
						<thead>
							<tr>
								<th style="width:80px;">Order ID</th>
								<th>Customer</th>
								<th style="width:150px;">Status</th>
								<th style="width:120px;" class="text-right">Amount</th>
								<th style="width:180px;">Date</th>
								<th style="width:80px;">Action</th>
							</tr>
						</thead>
						<tbody>
							@{
								var recentOrders = ViewBag.RecentOrders as System.Collections.Generic.List<MultiShop.WebUI.Dtos.OrderDtos.OrderOrderingDtos.ResultOrderingByUserIdDto> ?? new System.Collections.Generic.List<MultiShop.WebUI.Dtos.OrderDtos.OrderOrderingDtos.ResultOrderingByUserIdDto>();
								var userMap = ViewBag.UserMap as System.Collections.Generic.Dictionary<string, string> ?? new System.Collections.Generic.Dictionary<string, string>();
							}
							@if (recentOrders.Any())
							{
								@foreach (var order in recentOrders)
								{
									var statusClass = (order.Status ?? "New").ToLowerInvariant() switch {
										"processing" => "badge-warning",
										"shipped" => "badge-info",
										"delivered" => "badge-success",
										"cancelled" => "badge-danger",
										_ => "badge-secondary"
									};
									<tr>
										<td><span class="badge badge-inverse-primary">#@order.OrderingId</span></td>
										<td class="text-truncate" style="max-width:200px;">@(userMap.ContainsKey(order.UserId) && !string.IsNullOrWhiteSpace(userMap[order.UserId]) ? userMap[order.UserId] : "—")</td>
										<td><span class="badge @statusClass">@(order.Status ?? "New")</span></td>
										<td class="text-right">@order.TotalPrice.ToString("C")</td>
										<td>@order.OrderDate.ToString("dd MMM yyyy, HH:mm")</td>
										<td>
											<a href="/User/MyOrder/Detail/@order.OrderingId" class="btn btn-sm btn-info" title="View Details">
												<i class="fa fa-eye"></i>
											</a>
										</td>
								</tr>
							}
							}
							else
							{
								<tr>
									<td colspan="6" class="text-center text-muted" style="padding:40px;">
										<i class="fa fa-shopping-bag" style="font-size:48px; opacity:0.3;"></i><br><br>
										No orders yet
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			</div>
		</div>
				</div>

			</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
@{
    var salesData = ViewBag.SalesData as List<decimal> ?? new List<decimal>();
    var salesLabels = ViewBag.SalesLabels as List<string> ?? new List<string>();
    var statusCounts = ViewBag.StatusCounts as Dictionary<string, int> ?? new Dictionary<string, int>();
}
// Sales Chart
const salesCtx = document.getElementById('salesChart');
if (salesCtx) {
    new Chart(salesCtx, {
        type: 'line',
        data: {
            labels: @Html.Raw(Json.Serialize(salesLabels)),
            datasets: [{
                label: 'Revenue',
                data: @Html.Raw(Json.Serialize(salesData)),
                borderColor: 'rgb(79, 70, 229)',
                backgroundColor: 'rgba(79, 70, 229, 0.1)',
                tension: 0.4,
                fill: true
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: {
                    display: true,
                    position: 'top'
                },
                tooltip: {
                    mode: 'index',
                    intersect: false
                }
            },
            scales: {
                y: {
                    beginAtZero: true,
                    ticks: {
                        callback: function(value) {
                            return '$' + value.toFixed(2);
                        }
                    }
                }
            }
        }
    });
}

// Status Chart
const statusCtx = document.getElementById('statusChart');
if (statusCtx) {
    const statusData = @Html.Raw(Json.Serialize(statusCounts.Values));
    const statusLabels = @Html.Raw(Json.Serialize(statusCounts.Keys));
    const statusColors = [
        'rgb(156, 163, 175)',  // New - gray
        'rgb(245, 158, 11)',   // Processing - yellow
        'rgb(14, 165, 233)',   // Shipped - blue
        'rgb(16, 185, 129)',   // Delivered - green
        'rgb(239, 68, 68)'     // Cancelled - red
    ];

    new Chart(statusCtx, {
        type: 'doughnut',
        data: {
            labels: statusLabels,
            datasets: [{
                data: statusData,
                backgroundColor: statusColors,
                borderWidth: 2,
                borderColor: '#fff'
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: {
                    position: 'bottom',
                    labels: {
                        padding: 15,
                        boxWidth: 12
                    }
                }
            }
        }
    });
}
</script>
}