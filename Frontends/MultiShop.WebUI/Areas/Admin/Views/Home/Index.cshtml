@{
    ViewData["Title"] = "MultiShop Admin ";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-lg-3 col-xs-6">
            <div class="media-box">
                <div class="media-icon pull-left"><i class="icon-bargraph"></i> </div>
                <div class="media-info">
                    <h5>Category Count</h5>
                    <h3>@ViewBag.CategoryCount</h3>
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-xs-6">
            <div class="media-box bg-sea">
                <div class="media-icon pull-left"><i class="icon-wallet"></i> </div>
                <div class="media-info">
                    <h5>Average Product Price</h5>
                    <h3>@ViewBag.AverageProductPrice</h3>
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-xs-6">
            <div class="media-box bg-blue">
                <div class="media-icon pull-left"><i class="icon-basket"></i> </div>
                <div class="media-info">
                    <h5>Product Count</h5>
                    <h3>@ViewBag.ProductCount</h3>
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-xs-6">
            <div class="media-box bg-green">
                <div class="media-icon pull-left"><i class="icon-layers"></i> </div>
                <div class="media-info">
                    <h5>Brand Count</h5>
                    <h3>@ViewBag.BrandCount</h3>
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-xs-6">
            <div class="media-box bg-purple">
                <div class="media-icon pull-left"><i class="icon-users"></i> </div>
                <div class="media-info">
                    <h5>User Count</h5>
                    <h3>@ViewBag.UserCount</h3>
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-xs-6">
            <div class="media-box bg-success">
                <div class="media-icon pull-left"><i class="icon-bubble"></i> </div>
                <div class="media-info">
                    <h5>Active Comments</h5>
                    <h3>@ViewBag.ActiveCommentCount</h3>
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-xs-6">
            <div class="media-box bg-warning">
                <div class="media-icon pull-left"><i class="icon-bubbles"></i> </div>
                <div class="media-info">
                    <h5>Passive Comments</h5>
                    <h3>@ViewBag.PassiveCommentCount</h3>
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-xs-6">
            <div class="media-box bg-danger">
                <div class="media-icon pull-left"><i class="icon-bubble"></i> </div>
                <div class="media-info">
                    <h5>Total Comments</h5>
                    <h3>@ViewBag.TotalCommentCount</h3>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-lg-7">
            <div class="chart-box">
                <h4>Cheapest & Most Expensive Products</h4>
                <div class="table-responsive">
                    <table class="table table-striped table-bordered table-hover">
                        <thead class="bg-info">
                            <tr>
                                <th>Type</th>
                                <th>Product</th>
                                <th class="text-right">Price</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (ViewBag.CheapestProduct != null)
                            {
                                <tr class="table-success">
                                    <td>Cheapest</td>
                                    <td>@ViewBag.CheapestProduct.ProductName</td>
                                    <td class="text-right">@(((decimal)ViewBag.CheapestProduct.Price).ToString("C"))</td>
                                </tr>
                            }
                            else
                            {
                                <tr class="table-success">
                                    <td>Cheapest</td>
                                    <td colspan="2" class="text-muted">No product</td>
                                </tr>
                            }

                            @if (ViewBag.MostExpensiveProduct != null)
                            {
                                <tr class="table-danger">
                                    <td>Most Expensive</td>
                                    <td>@ViewBag.MostExpensiveProduct.ProductName</td>
                                    <td class="text-right">@(((decimal)ViewBag.MostExpensiveProduct.Price).ToString("C"))</td>
                                </tr>
                            }
                            else
                            {
                                <tr class="table-danger">
                                    <td>Most Expensive</td>
                                    <td colspan="2" class="text-muted">No product</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="col-lg-5">
            <div class="chart-box">
                <h4>Sales Overview</h4>
                <div class="chart">
                    <div id="container1"></div>
                    <!--for values check "Sales Overview" chart on char-function.js-->
                </div>
            </div>
        </div>
        <div class="col-lg-5">
            <div class="chart-box">
                <h4>Recent Messages</h4>
                <div class="message-widget">
                    @{ var msgs = ViewBag.RecentMessages as System.Collections.Generic.List<MultiShop.WebUI.Dtos.MessageDtos.ResultMessageDto> ?? new System.Collections.Generic.List<MultiShop.WebUI.Dtos.MessageDtos.ResultMessageDto>(); }
                    @if (msgs.Count > 0)
                    {
                        foreach (var m in msgs)
                        {
                            var iconClass = m.IsRead ? "fa fa-check-circle text-success" : "fa fa-times-circle text-danger";
                            <a href="#">
                                <div class="user-img pull-left"> <i class="@iconClass" style="font-size:28px; margin:8px 12px 0 0;"></i> </div>
                                <div class="mail-contnet">
                                    <h5>@(string.IsNullOrWhiteSpace(m.Subject) ? "(No Subject)" : m.Subject)</h5>
                                    <span class="mail-desc">@m.MessageDetail</span> <span class="time">@m.MessageDate.ToString("HH:mm")</span>
                                </div>
                            </a>
                        }
                    }
                    else
                    {
                        <div class="text-muted">No messages</div>
                    }
                </div>
            </div>
        </div>
        <div class="col-lg-7">
            <div class="chart-box">
                <h4>Recent Orders</h4>
