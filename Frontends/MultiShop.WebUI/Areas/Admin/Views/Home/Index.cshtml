@{
	ViewData["Title"] = "MultiShop Admin ";
	Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">
	<div class="row" style="margin-bottom:12px;">
		<div class="col-lg-12">
			<h2 style="margin:0;font-weight:700;">Dashboard</h2>
			<p class="text-muted" style="margin:4px 0 0 0;">Overview & Insights</p>
		</div>
	</div>
	<div class="row">
        <div class="col-lg-3 col-xs-6">
            <div class="media-box" style="background:linear-gradient(135deg,#4f46e5,#6366f1);color:#fff;border-radius:10px;box-shadow:0 2px 8px rgba(16,24,40,.12);">
                <div class="media-icon pull-left"><i class="fa fa-tags"></i> </div>
				<div class="media-info">
					<h5>Category Count</h5>
					<h3>@ViewBag.CategoryCount</h3>
				</div>
			</div>
		</div>
		<div class="col-lg-3 col-xs-6">
            <div class="media-box bg-sea" style="background:linear-gradient(135deg,#0ea5e9,#22d3ee);color:#fff;border-radius:10px;box-shadow:0 2px 8px rgba(16,24,40,.12);">
                <div class="media-icon pull-left"><i class="fa fa-credit-card"></i> </div>
				<div class="media-info">
					<h5>Average Product Price</h5>
					<h3>@ViewBag.AverageProductPrice</h3>
				</div>
			</div>
		</div>
		<div class="col-lg-3 col-xs-6">
            <div class="media-box bg-blue" style="background:linear-gradient(135deg,#2563eb,#3b82f6);color:#fff;border-radius:10px;box-shadow:0 2px 8px rgba(16,24,40,.12);">
                <div class="media-icon pull-left"><i class="fa fa-cubes"></i> </div>
				<div class="media-info">
					<h5>Product Count</h5>
					<h3>@ViewBag.ProductCount</h3>
				</div>
			</div>
		</div>
		<div class="col-lg-3 col-xs-6">
            <div class="media-box bg-green" style="background:linear-gradient(135deg,#16a34a,#22c55e);color:#fff;border-radius:10px;box-shadow:0 2px 8px rgba(16,24,40,.12);">
                <div class="media-icon pull-left"><i class="fa fa-briefcase"></i> </div>
				<div class="media-info">
					<h5>Brand Count</h5>
					<h3>@ViewBag.BrandCount</h3>
				</div>
			</div>
		</div>
		<div class="col-lg-3 col-xs-6">
            <div class="media-box bg-purple" style="background:linear-gradient(135deg,#7e22ce,#a855f7);color:#fff;border-radius:10px;box-shadow:0 2px 8px rgba(16,24,40,.12);">
                <div class="media-icon pull-left"><i class="fa fa-users"></i> </div>
				<div class="media-info">
					<h5>User Count</h5>
					<h3>@ViewBag.UserCount</h3>
				</div>
			</div>
		</div>
		<div class="col-lg-3 col-xs-6">
