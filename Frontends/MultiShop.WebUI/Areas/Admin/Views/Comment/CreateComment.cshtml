@using MultiShop.WebUI.Dtos.CommentDtos
@model CreateCommentDto
@{
	ViewData["Title"] = "CreateComment";
	Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<section class="content container-fluid">
	<div class="row">
		<div class="col-md-12">
			<div class="chart-box">
					<style>
					.chart-box{ border-radius:8px; border:1px solid rgba(0,0,0,.08); overflow:hidden; }
					.page-header { display:flex; align-items:center; justify-content:space-between; margin:0 0 12px 0; }
					.page-header h4 { margin:0; font-weight:600; }
					.form-group{ margin-bottom:12px; }
					.form-control{ border-radius:8px; border:1px solid rgba(0,0,0,.15); box-shadow:none; }
					.form-control:focus{ border-color:#0d6efd; box-shadow:0 0 0 .1rem rgba(13,110,253,.15); }
					.btn-add{ background:#198754; border-color:#198754; color:#fff; border-radius:20px; padding:8px 14px; transition:all .15s ease; box-shadow:0 2px 6px rgba(25,135,84,.18); }
					.btn-add:hover{ background:#157347; border-color:#157347; color:#fff; box-shadow:0 6px 16px rgba(25,135,84,.35); transform: translateY(-1px); text-decoration:none; }
					.btn-cancel{ border-radius:20px; padding:8px 14px; }
						.centered-label{ display:block; text-align:center; }
						.select-clean{ padding:8px 12px; height:38px; line-height:1.5; }
						.divider{ display:flex; align-items:center; gap:12px; margin:6px 0; }
						.divider .line{ height:1px; background:rgba(0,0,0,.15); flex:1; }
						.divider .text{ font-size:12px; color:#6c757d; white-space:nowrap; }
				</style>

				<div class="page-header">
					<h4>Create Comment</h4>
					<a asp-area="Admin" asp-controller="Comment" asp-action="Index" class="btn btn-default btn-cancel"><i class="fa fa-arrow-left"></i> Back</a>
				</div>

				<div class="bs-example" data-example-id="bordered-table">

					<form method="post">
						<div class="form-group">
							<label>First Name</label>
							<input type="text" class="form-control" asp-for="FirstName" required />
							<span asp-validation-for="FirstName" class="text-danger"></span>
						</div>
						<div class="form-group">
							<label>Last Name</label>
							<input type="text" class="form-control" asp-for="LastName" required />
							<span asp-validation-for="LastName" class="text-danger"></span>
						</div>
						<div class="form-group">
							<label>Email</label>
							<input type="email" class="form-control" asp-for="Email" required />
							<span asp-validation-for="Email" class="text-danger"></span>
						</div>
					<div class="form-group">
						<label>Avatar Image</label>
						<input type="hidden" asp-for="ImageUrl" />
						<div class="custom-file" style="display:flex; align-items:center; gap:8px;">
							<input type="file" id="commentImageFile" accept="image/*" style="display:none;" />
							<label for="commentImageFile" class="btn btn-default btn-upload" style="border-radius:20px; padding:8px 14px; border:1px solid #0d6efd; color:#0d6efd; background:#fff; box-shadow:0 1px 2px rgba(13,110,253,.08);"><i class="fa fa-upload" style="margin-right:6px;"></i> Choose Image</label>
							<span id="commentFileNameText" class="file-name" style="font-size:13px; color:#6c757d;">No file chosen</span>
						</div>
						<div class="preview-wrap" style="margin-top:8px;">
							<img id="commentImagePreview" class="preview-img" alt="Preview" style="display:none; width:120px; height:120px; object-fit:cover; border-radius:8px; border:1px solid rgba(0,0,0,.1); box-shadow:0 2px 6px rgba(0,0,0,.06);" />
						</div>
						<div id="commentUploadError" class="alert alert-danger" style="display:none; margin-top:8px;"></div>
					</div>
					<div class="form-group">
						<div class="divider"><span class="line"></span><span class="text">Product</span><span class="line"></span></div>
							@Html.DropDownListFor(x => x.ProductId, (List<SelectListItem>)ViewBag.Products, new { @style = "padding:0;", @class = "form-control" })
							<span asp-validation-for="ProductId" class="text-danger"></span>
						</div>
					<div class="form-group">
					<label>Select Rating</label>
					<select class="form-control select-clean" asp-for="Rating" required>
								<option value="">Select Rating</option>
								<option value="1">1 Star</option>
								<option value="2">2 Stars</option>
								<option value="3">3 Stars</option>
								<option value="4">4 Stars</option>
								<option value="5">5 Stars</option>
							</select>
							<span asp-validation-for="Rating" class="text-danger"></span>
						</div>
						<div class="form-group">
							<label>Comment Detail</label>
							<textarea class="form-control" asp-for="CommentDetail" rows="5" required></textarea>
							<span asp-validation-for="CommentDetail" class="text-danger"></span>
						</div>
						<div style="display:flex; align-items:center; gap:8px;">
						<button id="commentSubmitBtn" type="button" class="btn btn-add"><i class="fa fa-save" style="margin-right:8px;"></i> Add Comment</button>
							<a asp-area="Admin" asp-controller="Comment" asp-action="Index" class="btn btn-default btn-cancel">Cancel</a>
						</div>
					</form>

					<script>
					(function(){
					  var btn = document.getElementById('commentSubmitBtn');
					  var fileInput = document.getElementById('commentImageFile');
					  var formEl = document.querySelector('form[method="post"]');
					  var fileNameText = document.getElementById('commentFileNameText');
					  var previewImg = document.getElementById('commentImagePreview');
					  if (fileInput && fileNameText){
					    fileInput.addEventListener('change', function(){
					      var f = (fileInput.files && fileInput.files[0]) ? fileInput.files[0] : null;
					      fileNameText.textContent = f ? f.name : 'No file chosen';
					      if (previewImg){
					        if (f){ previewImg.src = URL.createObjectURL(f); previewImg.style.display = 'inline-block'; }
					        else { previewImg.removeAttribute('src'); previewImg.style.display = 'none'; }
					      }
					    });
					  }
					  if(!btn || !formEl) return;
					  btn.addEventListener('click', function(){
					    var errBox = document.getElementById('commentUploadError');
					    if (errBox) { errBox.style.display = 'none'; errBox.textContent = ''; }
					    var file = fileInput && fileInput.files && fileInput.files[0];
					    if(!file){ formEl.submit(); return; }
					    btn.disabled = true; var originalText = btn.innerHTML; btn.innerHTML = '<i class="fa fa-spinner fa-spin"></i> Uploading...';
					    var data = new FormData();
					    data.append('file', file);
					    fetch('/Admin/Comment/UploadImage', { method:'POST', body:data })
					      .then(function(r){ return r.ok ? r.json() : r.text().then(function(t){ throw new Error(t || ('HTTP '+r.status)); }); })
					      .then(function(res){
					        var p = Promise.resolve(null);
					        if (res && res.fileName){
					          p = fetch('/Admin/Comment/GetSignedUrl?fileName='+encodeURIComponent(res.fileName)+'&minutes=10080')
					            .then(function(r){ return r.ok ? r.json() : null; })
					            .catch(function(){ return null; });
					        }
					        return p.then(function(signed){
					          var imageInput = document.querySelector('input[name="ImageUrl"]');
					          if (imageInput){
					            if (signed && signed.signedUrl){ imageInput.value = signed.signedUrl; }
					            else if(res && res.url){ imageInput.value = res.url; }
					          }
					          formEl.submit();
					        });
					      })
					      .catch(function(e){
					        if (errBox) { errBox.textContent = 'Image upload failed. '+ (e && e.message ? e.message : ''); errBox.style.display = 'block'; }
					        btn.disabled = false; btn.innerHTML = originalText;
					      });
					  });
					})();
					</script>
				</div>
			</div>
		</div>
	</div>
</section>
