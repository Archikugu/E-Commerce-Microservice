@using MultiShop.WebUI.Dtos.IdentityDtos.UserDtos
@model List<ResultUserDto>
@{
    ViewData["Title"] = "User List";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    int pageNumber = 1;
    int pageSize = 10;
    int.TryParse(Context.Request.Query["pageNumber"], out pageNumber);
    int.TryParse(Context.Request.Query["pageSize"], out pageSize);
    pageNumber = pageNumber <= 0 ? 1 : pageNumber;
    pageSize = pageSize <= 0 ? 10 : pageSize;
    var totalItems = Model?.Count ?? 0;
    var items = (Model ?? new List<ResultUserDto>()).Skip((pageNumber - 1) * pageSize).Take(pageSize).ToList();
}

<section class="content container-fluid">
    <div class="row">
        <div class="col-md-12">
            <div class="chart-box">
                <style>
                    .chart-box{ border-radius:8px; border:1px solid rgba(0,0,0,.08); overflow:hidden; }
                    .page-header { display:flex; align-items:center; justify-content:space-between; margin:0 0 12px 0; }
                    .page-header h4 { margin:0; font-weight:600; }
                    .table .btn { border-radius:16px; padding:6px 10px; }
                    .btn-info{ background:#0dcaf0; border-color:#0dcaf0; color:#fff; }
                    .table > thead > tr > th,
                    .table > tbody > tr > th,
                    .table > tbody > tr > td { vertical-align: middle; }
                </style>
                <div class="page-header">
                    <h4>Users</h4>
                    <form method="get" style="display:flex; align-items:center; gap:6px; margin:0;">
                        <input type="hidden" name="pageNumber" value="1" />
                        <label class="text-muted" style="font-size:12px; margin:0;">Items per page</label>
                        <select name="pageSize" class="form-control" style="display:inline-block; width:auto; padding:4px 10px; height:32px; line-height:20px; border:1px solid rgba(0,0,0,.15); border-radius:16px; background-color:#fff; color:#212529;" onchange="this.form.submit()">
                            <option value="5" selected="@(pageSize==5 ? "selected" : null)">5</option>
                            <option value="10" selected="@(pageSize==10 ? "selected" : null)">10</option>
                            <option value="25" selected="@(pageSize==25 ? "selected" : null)">25</option>
                            <option value="50" selected="@(pageSize==50 ? "selected" : null)">50</option>
                            <option value="100" selected="@(pageSize==100 ? "selected" : null)">100</option>
                        </select>
                    </form>
                </div>
                <div class="bs-example" data-example-id="simple-table">
                    <table class="table table-striped table-hover">
						<thead>
							<tr>
								<th>#</th>
								<th>Id</th>
								<th>Full Name</th>
								<th>User Name</th>
								<th>Email</th>
								<th>Email Confirmed</th>
								<th>Phone</th>
								<th>2FA</th>
								<th>Lockout</th>
								<th>Access Failed</th>
								<th>Address Detail</th>
							</tr>
						</thead>
                        <tbody>
                            @if (items != null && items.Any())
                            {
                                var i = 0;
                                foreach (var u in items)
                                {
                                    i++;
                                    <tr>
                                        <td>@(((pageNumber-1)*pageSize)+i)</td>
                                        <td>@u.Id</td>
                                        <td>@u.FullName</td>
                                        <td>@u.UserName</td>
                                        <td>@u.Email</td>
                                        <td>@(u.EmailConfirmed ? "Yes" : "No")</td>
                                        <td>@u.PhoneNumber</td>
                                        <td>@(u.TwoFactorEnabled ? "On" : "Off")</td>
                                        <td>@(u.LockoutEnabled ? (u.LockoutEnd?.ToString("dd MMM yyyy HH:mm") ?? "Enabled") : "Disabled")</td>
                                        <td>@u.AccessFailedCount</td>
                                        <td><a asp-area="Admin" asp-controller="User" asp-action="UserAddressInfo" asp-route-id="@u.Id" class="btn btn-info btn-sm"><i class="fa fa-map"></i> Address Detail</a></td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="11" class="text-center">No users found.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div style="text-align:center; margin-top:16px;">
                    <nav aria-label="User pagination" style="display:inline-block;">
                        <ul class="pagination pagination-sm" style="margin:0; display:inline-flex;">
                            @{
                                int totalPages = Math.Max(1, (int)Math.Ceiling((double)totalItems / Math.Max(1, pageSize)));
                                int prev = Math.Max(1, pageNumber - 1);
                                int next = Math.Min(totalPages, pageNumber + 1);
                                int start = Math.Max(1, pageNumber - 2);
                                int end = Math.Min(totalPages, start + 4);
                            }
                            <li class="@(pageNumber == 1 ? "disabled" : null)"><a asp-area="Admin" asp-controller="User" asp-action="UserList" asp-route-pageNumber="1" asp-route-pageSize="@pageSize">First</a></li>
                            <li class="@(pageNumber == 1 ? "disabled" : null)"><a asp-area="Admin" asp-controller="User" asp-action="UserList" asp-route-pageNumber="@prev" asp-route-pageSize="@pageSize">Prev</a></li>
                            @for (int p = start; p <= end; p++)
                            {
                                <li class="@(p == pageNumber ? "active" : null)"><a asp-area="Admin" asp-controller="User" asp-action="UserList" asp-route-pageNumber="@p" asp-route-pageSize="@pageSize">@p</a></li>
                            }
                            <li class="@(pageNumber == totalPages ? "disabled" : null)"><a asp-area="Admin" asp-controller="User" asp-action="UserList" asp-route-pageNumber="@next" asp-route-pageSize="@pageSize">Next</a></li>
                            <li class="@(pageNumber == totalPages ? "disabled" : null)"><a asp-area="Admin" asp-controller="User" asp-action="UserList" asp-route-pageNumber="@totalPages" asp-route-pageSize="@pageSize">Last</a></li>
                        </ul>
                    </nav>
                </div>
            </div>
        </div>
	</div>
</section>