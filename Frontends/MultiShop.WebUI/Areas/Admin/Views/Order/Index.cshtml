@using MultiShop.WebUI.Dtos.OrderDtos.OrderOrderingDtos
@model List<ResultOrderingByUserIdDto>
@{
    ViewData["Title"] = "Orders";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    int count = 0;
}

<section class="content container-fluid">
    <div class="row">
        <div class="col-md-12">
            <div class="chart-box">
                <style>
                    .chart-box{ border-radius:8px; border:1px solid rgba(0,0,0,.08); overflow:hidden; }
                    .table .btn { border-radius: 16px; padding: 6px 10px; }
                    .btn-view{ background:#0dcaf0; border-color:#0dcaf0; color:#fff; }
                    .items-per-page-select{ display:inline-block; width:auto; padding:4px 10px; height:32px; line-height:20px; border:1px solid rgba(0,0,0,.15); border-radius:16px; background-color:#fff; color:#212529; }
                    .table > thead > tr > th,
                    .table > tbody > tr > th,
                    .table > tbody > tr > td { vertical-align: middle; }
                </style>
                <div class="clearfix" style="display:flex; align-items:center; justify-content:space-between; margin-bottom:12px;">
                    <div style="display:flex; align-items:center; gap:10px;">
                        <h3 style="margin:0; font-weight:600;">Orders</h3>
                        <input id="q" type="text" class="form-control items-per-page-select" placeholder="Search by Order/User" style="min-width:280px;" />
                    </div>
                    <div style="margin-left:auto; display:flex; align-items:center; gap:6px;">
                        <form method="get" style="display:flex; align-items:center; gap:6px;">
                            <input type="hidden" name="pageNumber" value="1" />
                            @{
                                int curSize = (int)(ViewBag.PageSize ?? 10);
                            }
                            <label class="text-muted items-per-page-label" style="margin:0;">Items per page</label>
                            <select name="pageSize" class="form-control items-per-page-select" onchange="this.form.submit()">
                                <option value="5" selected="@(curSize==5 ? "selected" : null)">5</option>
                                <option value="10" selected="@(curSize==10 ? "selected" : null)">10</option>
                                <option value="25" selected="@(curSize==25 ? "selected" : null)">25</option>
                                <option value="50" selected="@(curSize==50 ? "selected" : null)">50</option>
                                <option value="100" selected="@(curSize==100 ? "selected" : null)">100</option>
                            </select>
                        </form>
                    </div>
                </div>
                <div class="bs-example" data-example-id="simple-table">
                    @functions{
                        public static string GetStatusClass(string? status)
                        {
                            status = (status ?? "New").ToLowerInvariant();
                            return status switch
                            {
                                "processing" => "badge-warning",
                                "shipped" => "badge-info",
                                "delivered" => "badge-success",
                                "cancelled" => "badge-danger",
                                _ => "badge-secondary"
                            };
                        }
                    }
                    <table class="table table-striped table-hover" id="ordersTable" style="margin-bottom:0;">
                        <thead>
                            <tr>
                                <th style="width:60px;">#</th>
                                <th style="width:120px;">Order ID</th>
                                <th>Customer</th>
                                <th>User ID</th>
                                <th style="width:140px;">Status</th>
                                <th style="width:160px;" class="text-right">Total</th>
                                <th style="width:220px;">Date</th>
                                <th style="width:110px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ var userMap = ViewBag.UserMap as Dictionary<string, string> ?? new Dictionary<string, string>(); }
                            @foreach (var o in Model.OrderByDescending(x => x.OrderDate))
                            {
                                count++;
                                <tr>
                                    <th scope="row">@count</th>
                                    <td><span class="badge badge-inverse-primary">#@o.OrderingId</span></td>
                                    <td style="max-width:280px;" class="text-truncate">@(userMap.ContainsKey(o.UserId) && !string.IsNullOrWhiteSpace(userMap[o.UserId]) ? userMap[o.UserId] : "—")</td>
                                    <td style="max-width:420px;" class="text-truncate">@o.UserId</td>
                                    <td>
                                        <div class="d-flex align-items-center" style="gap:6px;">
                                            <span class="badge @(GetStatusClass(o.Status))" id="status-badge-@o.OrderingId">@(o.Status ?? "New")</span>
                                            <select class="form-control items-per-page-select" style="height:28px; padding:2px 8px;" data-order-id="@o.OrderingId">
                                                @{ var statuses = new[]{"New","Processing","Shipped","Delivered","Cancelled"}; }
                                                @foreach (var s in statuses)
                                                {
                                                    <option value="@s" selected="@((o.Status ?? "New").Equals(s, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@s</option>
                                                }
                                            </select>
                                        </div>
                                    </td>
                                    <td class="text-right">@o.TotalPrice.ToString("C")</td>
                                    <td>@o.OrderDate.ToString("dd MMM yyyy, HH:mm")</td>
                                    <td>
                                        <a href="/User/MyOrder/Detail/@o.OrderingId" class="btn btn-view btn-sm" target="_blank">
                                            <i class="fa fa-external-link"></i> View
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div style="text-align:center; margin-top:16px;">
                    <nav aria-label="Orders pagination" style="display:inline-block;">
                        <ul class="pagination pagination-sm" style="margin:0; display:inline-flex;">
                            @{
                                int pageNumber = (int)(ViewBag.PageNumber ?? 1);
                                int pageSize = (int)(ViewBag.PageSize ?? 10);
                                int totalItems = (int)(ViewBag.TotalItems ?? 0);
                                int totalPages = Math.Max(1, (int)Math.Ceiling((double)totalItems / Math.Max(1, pageSize)));
                                int prev = Math.Max(1, pageNumber - 1);
                                int next = Math.Min(totalPages, pageNumber + 1);
                                int start = Math.Max(1, pageNumber - 2);
                                int end = Math.Min(totalPages, start + 4);
                            }
                            <li class="@(pageNumber == 1 ? "disabled" : null)"><a asp-area="Admin" asp-controller="Order" asp-action="Index" asp-route-pageNumber="1" asp-route-pageSize="@pageSize">First</a></li>
                            <li class="@(pageNumber == 1 ? "disabled" : null)"><a asp-area="Admin" asp-controller="Order" asp-action="Index" asp-route-pageNumber="@prev" asp-route-pageSize="@pageSize">Prev</a></li>
                            @for (int i = start; i <= end; i++)
                            {
                                <li class="@(i == pageNumber ? "active" : null)"><a asp-area="Admin" asp-controller="Order" asp-action="Index" asp-route-pageNumber="@i" asp-route-pageSize="@pageSize">@i</a></li>
                            }
                            <li class="@(pageNumber == totalPages ? "disabled" : null)"><a asp-area="Admin" asp-controller="Order" asp-action="Index" asp-route-pageNumber="@next" asp-route-pageSize="@pageSize">Next</a></li>
                            <li class="@(pageNumber == totalPages ? "disabled" : null)"><a asp-area="Admin" asp-controller="Order" asp-action="Index" asp-route-pageNumber="@totalPages" asp-route-pageSize="@pageSize">Last</a></li>
                        </ul>
                    </nav>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
<script>
(function(){
    var q = document.getElementById('q');
    var table = document.getElementById('ordersTable');
    if (!q || !table) return;
    q.addEventListener('input', function(){
        var v = (this.value || '').toLowerCase();
        table.querySelectorAll('tbody tr').forEach(function(r){
            r.style.display = r.textContent.toLowerCase().indexOf(v) >= 0 ? '' : 'none';
        });
    });
    // status change
    table.querySelectorAll('select[data-order-id]').forEach(function(sel){
        sel.addEventListener('change', async function(){
            var id = this.getAttribute('data-order-id');
            var val = this.value;
            try{
                const resp = await fetch('/Admin/Order/UpdateStatus?id='+encodeURIComponent(id)+'&status='+encodeURIComponent(val), { method:'PATCH' });
                if (resp.ok){
                    var badge = document.getElementById('status-badge-'+id);
                    if (badge){
                        badge.textContent = val;
                        badge.className = 'badge ' + (val.toLowerCase()==='processing'?'badge-warning':val.toLowerCase()==='shipped'?'badge-info':val.toLowerCase()==='delivered'?'badge-success':val.toLowerCase()==='cancelled'?'badge-danger':'badge-secondary');
                    }
                } else {
                    var errText = await resp.text();
                    console.error('Status update failed:', resp.status, errText);
                    alert('Failed to update status: ' + (errText || resp.statusText));
                }
            }catch(e){ 
                console.error('Exception during status update:', e);
                alert('Failed to update status: ' + e.message); 
            }
        });
    });
})();
</script>
}


