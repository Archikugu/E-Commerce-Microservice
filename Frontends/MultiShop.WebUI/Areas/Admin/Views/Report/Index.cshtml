@{
    ViewData["Title"] = "Reports";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<section class="content container-fluid">
    <div class="row">
        <div class="col-md-12" style="margin-bottom:20px;">
            <h3 style="margin:0; font-weight:600;">Sales & Analytics Reports</h3>
        </div>
    </div>

    <!-- Sales Report -->
    <div class="row">
        <div class="col-md-12">
            <div class="chart-box" style="border-radius:8px; border:1px solid rgba(0,0,0,.08); padding:20px; margin-bottom:20px;">
                <h4 class="mb-3" style="border-bottom:2px solid #e5e7eb; padding-bottom:8px;">Sales Report</h4>
                <div class="row">
                    <div class="col-lg-3 col-xs-6">
                        <div class="media-box" style="background:linear-gradient(135deg,#4f46e5,#6366f1);color:#fff;border-radius:10px;box-shadow:0 2px 8px rgba(16,24,40,.12); padding:20px; margin-bottom:15px;">
                            <div class="media-icon pull-left"><i class="fa fa-dollar"></i> </div>
                            <div class="media-info">
                                <h5>Total Revenue</h5>
                                <h3>@ViewBag.TotalRevenue.ToString("C")</h3>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-3 col-xs-6">
                        <div class="media-box" style="background:linear-gradient(135deg,#0ea5e9,#22d3ee);color:#fff;border-radius:10px;box-shadow:0 2px 8px rgba(16,24,40,.12); padding:20px; margin-bottom:15px;">
                            <div class="media-icon pull-left"><i class="fa fa-shopping-cart"></i> </div>
                            <div class="media-info">
                                <h5>Total Orders</h5>
                                <h3>@ViewBag.TotalOrders</h3>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-3 col-xs-6">
                        <div class="media-box" style="background:linear-gradient(135deg,#16a34a,#22c55e);color:#fff;border-radius:10px;box-shadow:0 2px 8px rgba(16,24,40,.12); padding:20px; margin-bottom:15px;">
                            <div class="media-icon pull-left"><i class="fa fa-check-circle"></i> </div>
                            <div class="media-info">
                                <h5>Delivered Orders</h5>
                                <h3>@ViewBag.DeliveredOrders</h3>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-3 col-xs-6">
                        <div class="media-box" style="background:linear-gradient(135deg,#f59e0b,#f97316);color:#fff;border-radius:10px;box-shadow:0 2px 8px rgba(16,24,40,.12); padding:20px; margin-bottom:15px;">
                            <div class="media-icon pull-left"><i class="fa fa-clock-o"></i> </div>
                            <div class="media-info">
                                <h5>Pending Orders</h5>
                                <h3>@ViewBag.PendingOrders</h3>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Customer Report -->
    <div class="row">
        <div class="col-md-12">
            <div class="chart-box" style="border-radius:8px; border:1px solid rgba(0,0,0,.08); padding:20px; margin-bottom:20px;">
                <h4 class="mb-3" style="border-bottom:2px solid #e5e7eb; padding-bottom:8px;">Customer Report</h4>
                <div class="row">
                    <div class="col-lg-3 col-xs-6">
                        <div class="media-box" style="background:linear-gradient(135deg,#7e22ce,#a855f7);color:#fff;border-radius:10px;box-shadow:0 2px 8px rgba(16,24,40,.12); padding:20px; margin-bottom:15px;">
                            <div class="media-icon pull-left"><i class="fa fa-users"></i> </div>
                            <div class="media-info">
                                <h5>Total Customers</h5>
                                <h3>@ViewBag.UserCount</h3>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Catalog Report -->
    <div class="row">
        <div class="col-md-12">
            <div class="chart-box" style="border-radius:8px; border:1px solid rgba(0,0,0,.08); padding:20px; margin-bottom:20px;">
                <h4 class="mb-3" style="border-bottom:2px solid #e5e7eb; padding-bottom:8px;">Catalog Report</h4>
                <div class="row">
                    <div class="col-lg-3 col-xs-6">
                        <div class="media-box" style="background:linear-gradient(135deg,#4f46e5,#6366f1);color:#fff;border-radius:10px;box-shadow:0 2px 8px rgba(16,24,40,.12); padding:20px; margin-bottom:15px;">
                            <div class="media-icon pull-left"><i class="fa fa-tags"></i> </div>
                            <div class="media-info">
                                <h5>Categories</h5>
                                <h3>@ViewBag.CategoryCount</h3>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-3 col-xs-6">
                        <div class="media-box" style="background:linear-gradient(135deg,#2563eb,#3b82f6);color:#fff;border-radius:10px;box-shadow:0 2px 8px rgba(16,24,40,.12); padding:20px; margin-bottom:15px;">
                            <div class="media-icon pull-left"><i class="fa fa-cubes"></i> </div>
                            <div class="media-info">
                                <h5>Products</h5>
                                <h3>@ViewBag.ProductCount</h3>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-3 col-xs-6">
                        <div class="media-box" style="background:linear-gradient(135deg,#16a34a,#22c55e);color:#fff;border-radius:10px;box-shadow:0 2px 8px rgba(16,24,40,.12); padding:20px; margin-bottom:15px;">
                            <div class="media-icon pull-left"><i class="fa fa-briefcase"></i> </div>
                            <div class="media-info">
                                <h5>Brands</h5>
                                <h3>@ViewBag.BrandCount</h3>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-3 col-xs-6">
                        <div class="media-box" style="background:linear-gradient(135deg,#0ea5e9,#22d3ee);color:#fff;border-radius:10px;box-shadow:0 2px 8px rgba(16,24,40,.12); padding:20px; margin-bottom:15px;">
                            <div class="media-icon pull-left"><i class="fa fa-dollar"></i> </div>
                            <div class="media-info">
                                <h5>Avg Price</h5>
                                <h3>@ViewBag.AveragePrice</h3>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Content & Engagement -->
    <div class="row">
        <div class="col-md-12">
            <div class="chart-box" style="border-radius:8px; border:1px solid rgba(0,0,0,.08); padding:20px; margin-bottom:20px;">
                <h4 class="mb-3" style="border-bottom:2px solid #e5e7eb; padding-bottom:8px;">Content & Engagement</h4>
                <div class="row">
                    <div class="col-lg-4 col-xs-6">
                        <div class="media-box" style="background:linear-gradient(135deg,#059669,#10b981);color:#fff;border-radius:10px;box-shadow:0 2px 8px rgba(16,24,40,.12); padding:20px; margin-bottom:15px;">
                            <div class="media-icon pull-left"><i class="fa fa-comments"></i> </div>
                            <div class="media-info">
                                <h5>Active Comments</h5>
                                <h3>@ViewBag.ActiveComments</h3>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-4 col-xs-6">
                        <div class="media-box" style="background:linear-gradient(135deg,#eab308,#f59e0b);color:#fff;border-radius:10px;box-shadow:0 2px 8px rgba(16,24,40,.12); padding:20px; margin-bottom:15px;">
                            <div class="media-icon pull-left"><i class="fa fa-comments-o"></i> </div>
                            <div class="media-info">
                                <h5>Passive Comments</h5>
                                <h3>@ViewBag.PassiveComments</h3>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-4 col-xs-6">
                        <div class="media-box" style="background:linear-gradient(135deg,#dc2626,#ef4444);color:#fff;border-radius:10px;box-shadow:0 2px 8px rgba(16,24,40,.12); padding:20px; margin-bottom:15px;">
                            <div class="media-icon pull-left"><i class="fa fa-comment"></i> </div>
                            <div class="media-info">
                                <h5>Total Comments</h5>
                                <h3>@ViewBag.TotalComments</h3>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Discounts & Coupons -->
    <div class="row">
        <div class="col-md-12">
            <div class="chart-box" style="border-radius:8px; border:1px solid rgba(0,0,0,.08); padding:20px;">
                <h4 class="mb-3" style="border-bottom:2px solid #e5e7eb; padding-bottom:8px;">Discounts & Coupons</h4>
                <div class="row">
                    <div class="col-lg-4 col-xs-6">
                        <div class="media-box" style="background:linear-gradient(135deg,#4338ca,#6366f1);color:#fff;border-radius:10px;box-shadow:0 2px 8px rgba(16,24,40,.12); padding:20px; margin-bottom:15px;">
                            <div class="media-icon pull-left"><i class="fa fa-ticket"></i> </div>
                            <div class="media-info">
                                <h5>Total Coupons</h5>
                                <h3>@ViewBag.TotalCoupons</h3>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-4 col-xs-6">
                        <div class="media-box" style="background:linear-gradient(135deg,#0f766e,#14b8a6);color:#fff;border-radius:10px;box-shadow:0 2px 8px rgba(16,24,40,.12); padding:20px; margin-bottom:15px;">
                            <div class="media-icon pull-left"><i class="fa fa-check-circle"></i> </div>
                            <div class="media-info">
                                <h5>Active Coupons</h5>
                                <h3>@ViewBag.ActiveCoupons</h3>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-4 col-xs-6">
                        <div class="media-box" style="background:linear-gradient(135deg,#f59e0b,#f97316);color:#fff;border-radius:10px;box-shadow:0 2px 8px rgba(16,24,40,.12); padding:20px; margin-bottom:15px;">
                            <div class="media-icon pull-left"><i class="fa fa-times-circle"></i> </div>
                            <div class="media-info">
                                <h5>Expired Coupons</h5>
                                <h3>@ViewBag.ExpiredCoupons</h3>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

