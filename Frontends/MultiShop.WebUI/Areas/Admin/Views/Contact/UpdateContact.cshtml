@model MultiShop.WebUI.Dtos.CatalogDtos.ContactDtos.UpdateContactDto

@{
    ViewData["Title"] = "Update Contact";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<section class="content container-fluid">
    <div class="row">
        <div class="col-md-12">
            <div class="chart-box">
                <style>
                    .chart-box{ border-radius:8px; border:1px solid rgba(0,0,0,.08); overflow:hidden; }
                    .page-header { display:flex; align-items:center; justify-content:space-between; margin:0 0 12px 0; }
                    .page-header h4 { margin:0; font-weight:600; }
                    .form-group{ margin-bottom:12px; }
                    .form-control{ border-radius:8px; border:1px solid rgba(0,0,0,.15); box-shadow:none; }
                    .form-control:focus{ border-color:#0d6efd; box-shadow:0 0 0 .1rem rgba(13,110,253,.15); }
                    .btn-update{ background:#ffc107; border-color:#ffc107; color:#212529; border-radius:20px; padding:8px 14px; transition:all .15s ease; box-shadow:0 2px 6px rgba(255,193,7,.18); }
                    .btn-update:hover{ background:#e0a800; border-color:#e0a800; color:#212529; box-shadow:0 6px 16px rgba(255,193,7,.35); transform: translateY(-1px); text-decoration:none; }
                    .btn-cancel{ border-radius:20px; padding:8px 14px; }
                </style>
                <div class="page-header">
                    <h4>Update Contact</h4>
                    <a asp-area="Admin" asp-controller="Contact" asp-action="Index" class="btn btn-default btn-cancel"><i class="fa fa-arrow-left"></i> Back</a>
                </div>
                <p>Update the contact information below.</p>

                <form asp-area="Admin" asp-controller="Contact" asp-action="UpdateContact" method="post">
                    <input type="hidden" asp-for="ContactId" />
                    <input type="hidden" asp-for="SendDate" />
                    
                    <div asp-validation-summary="All" class="text-danger"></div>
                    
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="Name">Name</label>
                                <input asp-for="Name" class="form-control" placeholder="Enter name" />
                                <span asp-validation-for="Name" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="Email">Email</label>
                                <input asp-for="Email" type="email" class="form-control" placeholder="Enter email" />
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="Phone">Phone</label>
                                <input asp-for="Phone" class="form-control" placeholder="Enter phone number" />
                                <span asp-validation-for="Phone" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="Subject">Subject</label>
                                <input asp-for="Subject" class="form-control" placeholder="Enter subject" />
                                <span asp-validation-for="Subject" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label asp-for="Message">Message</label>
                        <textarea asp-for="Message" class="form-control" rows="5" placeholder="Enter message"></textarea>
                        <span asp-validation-for="Message" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <div class="custom-control custom-checkbox">
                            <input asp-for="IsRead" type="checkbox" class="custom-control-input" id="isReadCheck">
                            <label class="custom-control-label" for="isReadCheck">Mark as Read</label>
                        </div>
                    </div>

                    <div class="form-group" style="display:flex; align-items:center; gap:8px;">
                        <button type="submit" class="btn btn-update"><i class="fa fa-save" style="margin-right:8px;"></i> Update Contact</button>
                        <a asp-area="Admin" asp-controller="Contact" asp-action="Index" class="btn btn-default btn-cancel">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>


