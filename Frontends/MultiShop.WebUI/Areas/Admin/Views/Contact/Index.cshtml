@using MultiShop.WebUI.Dtos.CatalogDtos.ContactDtos
@model List<ResultContactDto>

@{
    ViewData["Title"] = "Contact List";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    int count = 0;
}

<section class="content container-fluid">
    <div class="row">
        <div class="col-md-12">
            <div class="chart-box">
                <style>
                    .chart-box{ border-radius:8px; border:1px solid rgba(0,0,0,.08); overflow:hidden; }
                    .page-header { display:flex; align-items:center; justify-content:space-between; margin:0 0 12px 0; }
                    .page-header h4 { margin:0; font-weight:600; }
                    .table .btn { border-radius:16px; padding:6px 10px; }
                    .btn-view{ background:#0dcaf0; border-color:#0dcaf0; color:#fff; }
                    .btn-update{ background:#ffc107; border-color:#ffc107; color:#212529; }
                    .btn-delete{ background:#dc3545; border-color:#dc3545; color:#fff; }
                    .btn-success{ border-radius:16px; }
                    .badge-read{ background:#28a745; }
                    .badge-unread{ background:#ffc107; color:#212529; }
                    .table > thead > tr > th,
                    .table > tbody > tr > th,
                    .table > tbody > tr > td { vertical-align: middle; }
                </style>
                <div class="page-header">
                    <h4>Contact List</h4>
                </div>

                <div class="bs-example" data-example-id="simple-table">
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Name</th>
                                <th>Email</th>
                                <th>Subject</th>
                                <th>Phone</th>
                                <th>Send Date</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                @foreach (var item in Model.OrderByDescending(x => x.SendDate))
                                {
                                    count++;
                                    <tr class="@(item.IsRead ? "" : "table-warning")">
                                        <th scope="row">@count</th>
                                        <td>@item.Name</td>
                                        <td>@item.Email</td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(item.Subject) && item.Subject.Length > 30)
                                            {
                                                @(item.Subject.Substring(0, 30) + "...")
                                            }
                                            else
                                            {
                                                @item.Subject
                                            }
                                        </td>
                                        <td>@(string.IsNullOrEmpty(item.Phone) ? "N/A" : item.Phone)</td>
                                        <td>@item.SendDate.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td>
                                            @if (item.IsRead)
                                            {
                                                <span class="badge badge-read">Read</span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-unread">Unread</span>
                                            }
                                        </td>
                                        <td>
                                            <a asp-area="Admin" asp-controller="Contact" asp-action="GetByIdContact" asp-route-id="@item.ContactId" class="btn btn-view btn-sm"><i class="fa fa-eye"></i> View</a>
                                            @if (!item.IsRead)
                                            {
                                                <a asp-area="Admin" asp-controller="Contact" asp-action="MarkAsRead" asp-route-id="@item.ContactId" class="btn btn-success btn-sm"><i class="fa fa-check"></i> Mark as Read</a>
                                            }
                                            <a asp-area="Admin" asp-controller="Contact" asp-action="UpdateContact" asp-route-id="@item.ContactId" class="btn btn-update btn-sm"><i class="fa fa-edit"></i> Update</a>
                                            <a asp-area="Admin" asp-controller="Contact" asp-action="DeleteContact" asp-route-id="@item.ContactId" class="btn btn-delete btn-sm" onclick="return confirm('Are you sure you want to delete this contact?')"><i class="fa fa-trash"></i> Delete</a>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="8" class="text-center">No contacts found.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</section>
