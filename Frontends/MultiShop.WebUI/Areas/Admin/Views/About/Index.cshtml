@using MultiShop.WebUI.Dtos.CatalogDtos.AboutDtos
@model List<ResultAboutDto>

@{
	ViewData["Title"] = "About List";
	Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
	int count = 0;
}

<section class="content container-fluid">
	<div class="row">
		<div class="col-md-12">
			<div class="chart-box">
				<style>
					.chart-box{ border-radius:8px; border:1px solid rgba(0,0,0,.08); overflow:hidden; }
					.page-header { display:flex; align-items:center; justify-content:space-between; margin:0 0 12px 0; }
					.page-header h4 { margin:0; font-weight:600; }
					.table .btn { border-radius:16px; padding:6px 10px; }
					.btn-update{ background:#ffc107; border-color:#ffc107; color:#212529; }
					.btn-delete{ background:#dc3545; border-color:#dc3545; color:#fff; }
					.btn-add{ background:#198754; border-color:#198754; color:#fff; border-radius:20px; padding:8px 14px; transition:all .15s ease; box-shadow:0 2px 6px rgba(25,135,84,.18); }
					.btn-add:hover{ background:#157347; border-color:#157347; color:#fff; box-shadow:0 6px 16px rgba(25,135,84,.35); transform: translateY(-1px); text-decoration:none; }
					.table > thead > tr > th,
					.table > tbody > tr > th,
					.table > tbody > tr > td { vertical-align: middle; }
				</style>
				<div class="page-header">
					<h4>About List</h4>
					<a asp-area="Admin" asp-controller="About" asp-action="CreateAbout" class="btn btn-add"><i class="fa fa-plus" style="margin-right:8px;"></i> Add New About</a>
				</div>

				<div class="bs-example" data-example-id="simple-table">
					<table class="table table-striped table-hover">
						<thead>
							<tr>
								<th>#</th>
								<th>Title</th>
								<th>Description</th>
								<th>Image</th>
								<th>Address</th>
								<th>Phone</th>
								<th>Email</th>
								<th>Working Hours</th>
								<th>Delete</th>
								<th>Update</th>
							</tr>
						</thead>
						<tbody>
							@foreach (var item in Model)
							{
								count++;
								<tr>
									<th scope="row">@count</th>
									<td>@item.Title</td>
									<td>@(item.Description?.Length > 50 ? item.Description.Substring(0, 50) + "..." : item.Description)</td>
									<td>
										@if (!string.IsNullOrEmpty(item.ImageUrl))
										{
											<img src="@item.ImageUrl" alt="@item.Title" style="width: 80px; height: 60px; object-fit: cover; border-radius: 4px;" />
										}
										else
										{
											<span class="text-muted">No Image</span>
										}
									</td>
									<td>@item.Address</td>
									<td>@item.Phone</td>
									<td>@item.Email</td>
									<td>@item.WorkingHours</td>
						<td><a asp-area="Admin" asp-controller="About" asp-action="DeleteAbout" asp-route-id="@item.AboutId" class="btn btn-delete btn-sm"><i class="fa fa-trash"></i> Delete</a></td>
						<td><a asp-area="Admin" asp-controller="About" asp-action="UpdateAbout" asp-route-id="@item.AboutId" class="btn btn-update btn-sm"><i class="fa fa-edit"></i> Update</a></td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			</div>
		</div>
	</div>
</section> 