@using MultiShop.WebUI.Dtos.CatalogDtos.AboutDtos
@model CreateAboutDto

@{
    ViewData["Title"] = "CreateAbout";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<section class="content container-fluid">
    <div class="row">
        <div class="col-md-12">
            <div class="chart-box">
                <style>
                    .chart-box{ border-radius:8px; border:1px solid rgba(0,0,0,.08); overflow:hidden; }
                    .page-header { display:flex; align-items:center; justify-content:space-between; margin:0 0 12px 0; }
                    .page-header h4 { margin:0; font-weight:600; }
                    .form-group{ margin-bottom:12px; }
                    .form-control{ border-radius:8px; border:1px solid rgba(0,0,0,.15); box-shadow:none; }
                    .form-control:focus{ border-color:#0d6efd; box-shadow:0 0 0 .1rem rgba(13,110,253,.15); }
                    .btn-add{ background:#198754; border-color:#198754; color:#fff; border-radius:20px; padding:8px 14px; transition:all .15s ease; box-shadow:0 2px 6px rgba(25,135,84,.18); }
                    .btn-add:hover{ background:#157347; border-color:#157347; color:#fff; box-shadow:0 6px 16px rgba(25,135,84,.35); transform: translateY(-1px); text-decoration:none; }
                    .btn-cancel{ border-radius:20px; padding:8px 14px; }
                    .custom-file{ display:flex; align-items:center; gap:8px; }
                    .btn-upload{ border-radius:20px; padding:8px 14px; border:1px solid #0d6efd; color:#0d6efd; background:#fff; box-shadow:0 1px 2px rgba(13,110,253,.08); }
                    .btn-upload:hover{ background:#0d6efd; color:#fff; box-shadow:0 4px 12px rgba(13,110,253,.3); }
                    .file-name{ font-size:13px; color:#6c757d; }
                    .preview-wrap{ margin-top:8px; }
                    .preview-img{ display:none; width:240px; height:160px; object-fit:cover; border-radius:8px; border:1px solid rgba(0,0,0,.1); box-shadow:0 2px 6px rgba(0,0,0,.06); }
                </style>
                <div class="page-header">
                    <h4>About Creation Page</h4>
                    <a asp-area="Admin" asp-controller="About" asp-action="Index" class="btn btn-default btn-cancel"><i class="fa fa-arrow-left"></i> Back</a>
                </div>
                <div class="bs-example" data-example-id="bordered-table">

                    <form method="post" id="aboutCreateForm">
                        <div class="form-group">
                            <label>Title</label>
                            <input type="text" class="form-control" asp-for="Title" placeholder="Enter title" />
                            <span asp-validation-for="Title" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label>Description</label>
                            <textarea class="form-control" asp-for="Description" rows="4" placeholder="Enter description"></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label>Image</label>
                            <input type="hidden" asp-for="ImageUrl" />
                            <div class="custom-file">
                                <input type="file" id="aboutCreateImageFile" accept="image/*" style="display:none;" />
                                <label for="aboutCreateImageFile" class="btn btn-default btn-upload"><i class="fa fa-upload" style="margin-right:6px;"></i> Choose Image</label>
                                <span id="aboutCreateFileNameText" class="file-name">No file chosen</span>
                            </div>
                            <div class="preview-wrap">
                                <img id="aboutCreateImagePreview" class="preview-img" alt="Preview" />
                            </div>
                        </div>
                        <div class="form-group">
                            <label>Address</label>
                            <input type="text" class="form-control" asp-for="Address" placeholder="Enter address" />
                            <span asp-validation-for="Address" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label>Phone</label>
                            <input type="text" class="form-control" asp-for="Phone" placeholder="Enter phone number" />
                            <span asp-validation-for="Phone" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label>Email</label>
                            <input type="email" class="form-control" asp-for="Email" placeholder="Enter email address" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label>Working Hours</label>
                            <input type="text" class="form-control" asp-for="WorkingHours" placeholder="Enter working hours" />
                            <span asp-validation-for="WorkingHours" class="text-danger"></span>
                        </div>
                        <div id="aboutCreateUploadError" class="alert alert-danger" style="display:none; margin-top:8px;"></div>
                        <div style="display:flex; align-items:center; gap:8px;">
                            <button type="button" id="aboutCreateSubmitBtn" class="btn btn-add"><i class="fa fa-save" style="margin-right:8px;"></i> Add About</button>
                            <a asp-area="Admin" asp-controller="About" asp-action="Index" class="btn btn-default btn-cancel">Cancel</a>
                        </div>
                        <script>
                            (function(){
                                var btn = document.getElementById('aboutCreateSubmitBtn');
                                var fileInput = document.getElementById('aboutCreateImageFile');
                                var formEl = document.getElementById('aboutCreateForm');
                                var fileNameText = document.getElementById('aboutCreateFileNameText');
                                var previewImg = document.getElementById('aboutCreateImagePreview');
                                if (fileInput && fileNameText){
                                    fileInput.addEventListener('change', function(){
                                        var f = (fileInput.files && fileInput.files[0]) ? fileInput.files[0] : null;
                                        fileNameText.textContent = f ? f.name : 'No file chosen';
                                        if (previewImg){
                                            if (f){ previewImg.src = URL.createObjectURL(f); previewImg.style.display = 'inline-block'; }
                                            else { previewImg.removeAttribute('src'); previewImg.style.display = 'none'; }
                                        }
                                    });
                                }
                                if(!btn || !formEl) return;
                                btn.addEventListener('click', function(){
                                    var errBox = document.getElementById('aboutCreateUploadError');
                                    if (errBox) { errBox.style.display = 'none'; errBox.textContent = ''; }
                                    var file = fileInput && fileInput.files && fileInput.files[0];
                                    if(!file){ formEl.submit(); return; }
                                    btn.disabled = true; var originalText = btn.innerHTML; btn.innerHTML = '<i class="fa fa-spinner fa-spin"></i> Uploading...';
                                    var data = new FormData();
                                    data.append('file', file);
                                    fetch('/Admin/About/UploadImage', { method:'POST', body:data })
                                        .then(function(r){ return r.ok ? r.json() : r.text().then(function(t){ throw new Error(t || ('HTTP '+r.status)); }); })
                                        .then(function(res){
                                            var p = Promise.resolve(null);
                                            if (res && res.fileName){
                                                p = fetch('/Admin/About/GetSignedUrl?fileName='+encodeURIComponent(res.fileName)+'&minutes=10080')
                                                    .then(function(r){ return r.ok ? r.json() : null; })
                                                    .catch(function(){ return null; });
                                            }
                                            return p.then(function(signed){
                                                var imageInput = document.querySelector('input[name="ImageUrl"]');
                                                if (imageInput){
                                                    if (signed && signed.signedUrl){ imageInput.value = signed.signedUrl; }
                                                    else if(res && res.url){ imageInput.value = res.url; }
                                                }
                                                formEl.submit();
                                            });
                                        })
                                        .catch(function(e){
                                            if (errBox) { errBox.textContent = 'Image upload failed. '+ (e && e.message ? e.message : ''); errBox.style.display = 'block'; }
                                            btn.disabled = false; btn.innerHTML = originalText;
                                        });
                                });
                            })();
                        </script>
                    </form>

                </div>
            </div>
        </div>
    </div>
</section> 