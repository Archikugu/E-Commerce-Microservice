@using MultiShop.WebUI.Dtos.CatalogDtos.ProductImageDtos
@model List<ResultProductImageDto>
@{
    ViewData["Title"] = "ProductImageGallery";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<section class="content container-fluid">
    <div class="row">
        <div class="col-md-12">
            <div class="chart-box">
                <style>
                    .chart-box{ border-radius:8px; border:1px solid rgba(0,0,0,.08); overflow:hidden; }
                    .page-header { display:flex; align-items:center; justify-content:space-between; margin:0 0 12px 0; }
                    .page-header h4 { margin:0; font-weight:600; }
                    .gallery-grid{ display:grid; grid-template-columns:repeat(auto-fill,minmax(220px,1fr)); gap:16px; }
                    .g-card{ position:relative; border-radius:10px; overflow:hidden; box-shadow:0 2px 8px rgba(0,0,0,.08); border:1px solid rgba(0,0,0,.06); }
                    .g-card img{ width:100%; height:220px; object-fit:cover; display:block; }
                    .g-overlay{ position:absolute; inset:0; background:linear-gradient(to top, rgba(0,0,0,.45), rgba(0,0,0,.05)); opacity:0; transition:opacity .2s ease; display:flex; align-items:flex-end; padding:10px; gap:8px; }
                    .g-card:hover .g-overlay{ opacity:1; }
                    .g-btn{ border-radius:16px; padding:6px 10px; color:#fff; border:none; background:rgba(255,255,255,.15); backdrop-filter: blur(2px); }
                    .g-btn:hover{ background:rgba(255,255,255,.28); }
                    .meta{ font-size:12px; color:#6c757d; }
                </style>
                <div class="page-header">
                    <h4>Product Image Gallery</h4>
                    <div style="display:flex; align-items:center; gap:8px;">
                        <span class="meta">Product ID: @ViewBag.ProductId • Total Images: @(Model?.SelectMany(x => x.Images ?? new List<string>()).Count() ?? 0)</span>
                        <a asp-area="Admin" asp-controller="ProductImage" asp-action="CreateProductImage" class="btn btn-success btn-sm"><i class="fa fa-plus" style="margin-right:6px;"></i> Add Images</a>
                        <a asp-area="Admin" asp-controller="ProductImage" asp-action="Index" class="btn btn-secondary btn-sm"><i class="fa fa-arrow-left" style="margin-right:6px;"></i> Back</a>
                    </div>
                </div>

                @if (Model != null && Model.Any())
                {
                    <div class="gallery-grid">
                        @foreach (var productImage in Model)
                        {
                            if (productImage.Images != null && productImage.Images.Any())
                            {
                                foreach (var image in productImage.Images)
                                {
                                    <div class="g-card">
                                        <img src="@image" alt="Product Image" />
                                        <div class="g-overlay">
                                            <button type="button" class="g-btn" onclick="showImageModal('@image')"><i class="fa fa-eye"></i> View</button>
                                            <button type="button" class="g-btn" onclick="copyImageUrl('@image')"><i class="fa fa-copy"></i> Copy</button>
                                        </div>
                                    </div>
                                }
                            }
                        }
                    </div>
                }
                else
                {
                    <div class="alert alert-info text-center">
                        <h5>No Images Found</h5>
                        <p>This product doesn't have any images yet.</p>
                        <a asp-area="Admin" asp-controller="ProductImage" asp-action="CreateProductImage" class="btn btn-success">Add Images</a>
                    </div>
                }

                <div class="mt-3 meta">Tip: Hover any image for quick actions.</div>
            </div>
        </div>
    </div>
</section>

<!-- Modal for Full Size Image -->
<div class="modal fade" id="imageModal" tabindex="-1" role="dialog" aria-labelledby="imageModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="imageModalLabel">Product Image</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body text-center">
                <img id="modalImage" src="" alt="Product Image" class="img-fluid" />
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<script>
    function showImageModal(imageUrl) {
        document.getElementById('modalImage').src = imageUrl;
        $('#imageModal').modal('show');
    }
    
    function copyImageUrl(imageUrl) {
        navigator.clipboard.writeText(imageUrl).then(function() {
            // Success feedback
            const originalText = event.target.innerHTML;
            event.target.innerHTML = '<i class="fa fa-check"></i> Copied!';
            event.target.classList.remove('btn-info');
            event.target.classList.add('btn-success');
            
            setTimeout(function() {
                event.target.innerHTML = originalText;
                event.target.classList.remove('btn-success');
                event.target.classList.add('btn-info');
            }, 2000);
        }, function(err) {
            alert('Could not copy URL: ' + err);
        });
    }
</script>

<style>
    .card {
        transition: transform 0.2s;
        display: flex;
        flex-direction: column;
    }
    
    .card:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 8px rgba(0,0,0,0.12);
    }
    
    .card-body {
        flex: 1;
    }
    
    .card-footer {
        margin-top: auto;
    }
    
    .modal-body img {
        max-width: 100%;
        height: auto;
        border-radius: 4px;
    }
</style>