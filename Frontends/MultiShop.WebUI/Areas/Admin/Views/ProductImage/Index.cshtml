@using MultiShop.WebUI.Dtos.CatalogDtos.ProductImageDtos
@using MultiShop.WebUI.Dtos.CatalogDtos.ProductDtos
@model List<ResultProductImageDto>
@{
	ViewData["Title"] = "Index";
	Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
	int count = 0;
	var products = ViewBag.Products as List<ResultProductDto>;
}

<section class="content container-fluid">
	<div class="row">
		<div class="col-md-12">
			<div class="chart-box">
				<style>
					.chart-box{ border-radius:8px; border:1px solid rgba(0,0,0,.08); overflow:hidden; }
					.page-header { display:flex; align-items:center; justify-content:space-between; margin:0 0 12px 0; }
					.page-header h4 { margin:0; font-weight:600; }
					.table .btn { border-radius:16px; padding:6px 10px; }
					.btn-update{ background:#ffc107; border-color:#ffc107; color:#212529; }
					.btn-delete{ background:#dc3545; border-color:#dc3545; color:#fff; }
					.btn-gallery{ background:#0dcaf0; border-color:#0dcaf0; color:#fff; }
					.btn-add{ background:#198754; border-color:#198754; color:#fff; border-radius:20px; padding:8px 14px; transition:all .15s ease; box-shadow:0 2px 6px rgba(25,135,84,.18); }
					.btn-add:hover{ background:#157347; border-color:#157347; color:#fff; box-shadow:0 6px 16px rgba(25,135,84,.35); transform: translateY(-1px); text-decoration:none; }
					.table > thead > tr > th,
					.table > tbody > tr > th,
					.table > tbody > tr > td { vertical-align: middle; }
				</style>
				<div class="page-header">
					<h4>Product Image List</h4>
					<a asp-area="Admin" asp-controller="ProductImage" asp-action="CreateProductImage" class="btn btn-add"><i class="fa fa-plus" style="margin-right:8px;"></i> Add New Product Images</a>
				</div>
				<div class="bs-example" data-example-id="simple-table">
					<table class="table table-striped table-hover">
						<thead>
							<tr>
								<th>#</th>
								<th>Product ID</th>
								<th>Product Name</th>
								<th>Images</th>
								<th>Image Count</th>
								<th>Delete</th>
								<th>Update</th>
								<th>Gallery</th>
							</tr>
						</thead>
						<tbody>
							@foreach (var item in Model)
							{
								count++;
								<tr>
									<th scope="row">@count</th>
									<td>@item.ProductId</td>
									<td>@(products?.FirstOrDefault(p => p.ProductId == item.ProductId)?.ProductName ?? "N/A")</td>
									<td>
										@if (item.Images != null && item.Images.Any())
										{
											@foreach (var image in item.Images.Take(3))
											{
												<img src="@image" alt="Product Image" style="width: 60px; height: 40px; object-fit: cover; border-radius: 4px; margin-right: 5px;" />
											}
											@if (item.Images.Count > 3)
											{
												<span class="text-muted">+@(item.Images.Count - 3) more</span>
											}
										}
										else
										{
											<span class="text-muted">No Images</span>
										}
									</td>
									<td>
										<span class="badge badge-info">@(item.Images?.Count ?? 0)</span>
									</td>
							<td><a asp-area="Admin" asp-controller="ProductImage" asp-action="DeleteProductImage" asp-route-id="@item.ProductImageId" class="btn btn-delete btn-sm"><i class="fa fa-trash"></i> Delete</a></td>
							<td><a asp-area="Admin" asp-controller="ProductImage" asp-action="UpdateProductImage" asp-route-id="@item.ProductImageId" class="btn btn-update btn-sm"><i class="fa fa-edit"></i> Update</a></td>
							<td><a asp-area="Admin" asp-controller="ProductImage" asp-action="ProductImageGallery" asp-route-productId="@item.ProductId" class="btn btn-gallery btn-sm"><i class="fa fa-image"></i> Gallery</a></td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			</div>
		</div>
	</div>
</section>