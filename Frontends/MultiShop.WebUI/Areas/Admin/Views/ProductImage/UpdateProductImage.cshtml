@using MultiShop.WebUI.Dtos.CatalogDtos.ProductImageDtos
@model UpdateProductImageDto
@{
    ViewData["Title"] = "UpdateProductImage";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<section class="content container-fluid">
    <div class="row">
        <div class="col-md-12">
            <div class="chart-box">
                <style>
                    .upload-item{ display:flex; align-items:center; gap:8px; margin-bottom:8px; }
                    .preview{ width:100px; height:75px; object-fit:cover; border-radius:6px; border:1px solid rgba(0,0,0,.1); display:none; }
                </style>
                <h4>Update Product Images</h4>

                <form asp-area="Admin" asp-controller="ProductImage" asp-action="UpdateProductImage" method="post">
                    <input type="hidden" asp-for="ProductImageId" />

                    <div asp-validation-summary="All" class="text-danger"></div>

                    <div class="form-group">
                        <label>Select Product</label>
                        @Html.DropDownListFor(x => x.ProductId, (List<SelectListItem>)ViewBag.Products, "Select a Product", new { @style = "padding:0;", @class = "form-control" })
                        <br />
                        
                        <label>Product Images</label>
                        <div id="imageContainer">
                            @if (Model?.Images != null && Model.Images.Any())
                            {
                                @for (int i = 0; i < Model.Images.Count; i++)
                                {
                                    <div class="upload-item">
                                        <img src="@Model.Images[i]" class="preview" style="display:inline-block;" />
                                        <input type="text" name="Images[@i]" value="@Model.Images[i]" class="form-control" placeholder="Image URL" />
                                        <button type="button" class="btn btn-danger remove-image" style="display:@(Model.Images.Count > 1 ? "block" : "none")">Remove</button>
                                    </div>
                                }
                            }
                        </div>
                        <div class="upload-item">
                            <input type="file" accept="image/*" multiple id="piUpdateFiles" />
                            <button type="button" id="piUpdateAddBtn" class="btn btn-secondary">Upload & Add</button>
                        </div>
                        <div id="piUpdateError" class="alert alert-danger" style="display:none;"></div>
                        <br />
                    </div>

                    <div class="form-group">
                        <button type="submit" class="btn btn-warning">Update Product Images</button>
                        <a asp-area="Admin" asp-controller="ProductImage" asp-action="Index" class="btn btn-secondary">Back to List</a>
                    </div>
                </form>
                <script>
                (function(){
                    var filesInput = document.getElementById('piUpdateFiles');
                    var addBtn = document.getElementById('piUpdateAddBtn');
                    var container = document.getElementById('imageContainer');
                    var errBox = document.getElementById('piUpdateError');
                    var imageIndex = @(Model?.Images?.Count ?? 0);

                    function addRow(url){
                        var wrap = document.createElement('div');
                        wrap.className = 'upload-item';
                        var img = document.createElement('img'); img.className='preview'; img.src=url; img.style.display='inline-block';
                        var input = document.createElement('input'); input.type='text'; input.name='Images['+ (imageIndex++) +']'; input.value=url; input.className='form-control';
                        var rm = document.createElement('button'); rm.type='button'; rm.className='btn btn-danger remove-image'; rm.textContent='Remove';
                        rm.addEventListener('click', function(){ wrap.remove(); });
                        wrap.appendChild(img); wrap.appendChild(input); wrap.appendChild(rm);
                        container.appendChild(wrap);
                    }

                    addBtn.addEventListener('click', function(){
                        if (!filesInput || !filesInput.files || filesInput.files.length === 0){ return; }
                        var files = Array.from(filesInput.files);
                        (function uploadNext(i){
                            if (i >= files.length){ return; }
                            var data = new FormData(); data.append('file', files[i]);
                            fetch('/Admin/ProductImage/UploadImage', { method:'POST', body:data })
                                .then(function(r){ return r.ok ? r.json() : r.text().then(function(t){ throw new Error(t || ('HTTP '+r.status)); }); })
                                .then(function(res){
                                    var p = Promise.resolve(null);
                                    if (res && res.fileName){
                                        p = fetch('/Admin/ProductImage/GetSignedUrl?fileName='+encodeURIComponent(res.fileName)+'&minutes=10080')
                                            .then(function(r){ return r.ok ? r.json() : null; })
                                            .catch(function(){ return null; });
                                    }
                                    return p.then(function(signed){
                                        var url = signed && signed.signedUrl ? signed.signedUrl : (res && res.url ? res.url : null);
                                        if (url){ addRow(url); }
                                        uploadNext(i+1);
                                    });
                                })
                                .catch(function(e){ if (errBox){ errBox.textContent='Upload failed: '+(e && e.message ? e.message : ''); errBox.style.display='block'; } uploadNext(i+1); });
                        })(0);
                    });
                })();
                </script>
            </div>
        </div>
    </div>
</section>

<script>
    let imageIndex = @(Model?.Images?.Count ?? 1);
    
    document.getElementById('addImageBtn').addEventListener('click', function() {
        const container = document.getElementById('imageContainer');
        const newDiv = document.createElement('div');
        newDiv.className = 'image-input-group mb-2';
        newDiv.innerHTML = `
            <div class="input-group">
                <input type="text" name="Images[${imageIndex}]" class="form-control" placeholder="Enter image URL" />
                <div class="input-group-append">
                    <button type="button" class="btn btn-danger remove-image">Remove</button>
                </div>
            </div>
        `;
        container.appendChild(newDiv);
        imageIndex++;
        updateRemoveButtons();
    });
    
    document.addEventListener('click', function(e) {
        if (e.target.classList.contains('remove-image')) {
            e.target.closest('.image-input-group').remove();
            updateIndexes();
            updateRemoveButtons();
        }
    });
    
    function updateIndexes() {
        const inputs = document.querySelectorAll('#imageContainer input[type="text"]');
        inputs.forEach((input, index) => {
            input.name = `Images[${index}]`;
        });
        imageIndex = inputs.length;
    }
    
    function updateRemoveButtons() {
        const removeButtons = document.querySelectorAll('.remove-image');
        removeButtons.forEach(button => {
            button.style.display = removeButtons.length > 1 ? 'block' : 'none';
        });
    }
</script>