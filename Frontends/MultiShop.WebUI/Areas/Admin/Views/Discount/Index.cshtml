@model List<MultiShop.WebUI.Dtos.DiscountDtos.DiscountCouponDtos.ResultDiscountCouponDto>

<section class="content container-fluid">
	<div class="row">
		<div class="col-md-12">
			<div class="chart-box">
				<style>
					.chart-box{ border-radius:8px; border:1px solid rgba(0,0,0,.08); overflow:hidden; }
					.page-header { display:flex; align-items:center; justify-content:space-between; margin:0 0 12px 0; }
					.page-header h4 { margin:0; font-weight:600; }
					.table .btn { border-radius:16px; padding:6px 10px; }
					.btn-add{ background:#198754; border-color:#198754; color:#fff; border-radius:20px; padding:8px 14px; transition:all .15s ease; box-shadow:0 2px 6px rgba(25,135,84,.18); }
					.btn-add:hover{ background:#157347; border-color:#157347; color:#fff; box-shadow:0 6px 16px rgba(25,135,84,.35); transform: translateY(-1px); text-decoration:none; }
					.btn-update{ background:#ffc107; border-color:#ffc107; color:#212529; }
					.btn-delete{ background:#dc3545; border-color:#dc3545; color:#fff; }
					.badge-active{ background:#28a745; }
					.badge-passive{ background:#6c757d; }
					.badge-expired{ background:#dc3545; }
					.table > thead > tr > th,
					.table > tbody > tr > th,
					.table > tbody > tr > td { vertical-align: middle; }
				</style>
				<div class="page-header">
					<h4>Discount Coupon List</h4>
					<a class="btn btn-add" href="/Admin/Discount/Create"><i class="fa fa-plus" style="margin-right:8px;"></i> Create Coupon</a>
				</div>

				<table class="table table-striped table-hover">
					<thead>
						<tr>
							<th style="width:60px;">#</th>
							<th>Code</th>
							<th>Rate (%)</th>
							<th>Active</th>
							<th>Valid Date</th>
							<th style="width:170px;">Actions</th>
						</tr>
					</thead>
					<tbody>
						@if (Model != null && Model.Any())
						{
							var i = 1;
							foreach (var item in Model)
							{
								<tr>
									<td>@i</td>
									<td style="font-weight:500;">@item.Code</td>
									<td>@item.Rate</td>
									<td>
										@{
											var isCurrentlyActive = item.IsActive && item.ValidDate.Date >= DateTime.Today;
										}
										@if (item.ValidDate.Date < DateTime.Today)
										{
											<span class="badge badge-expired">Expired</span>
										}
										else if (isCurrentlyActive)
										{
											<span class="badge badge-active">Active</span>
										}
										else
										{
											<span class="badge badge-passive">Inactive</span>
										}
									</td>
									<td>@item.ValidDate.ToString("yyyy-MM-dd")</td>
									<td>
										<a class="btn btn-sm btn-update" href="/Admin/Discount/Update?id=@item.CouponId"><i class="fa fa-edit"></i> Edit</a>
										<a class="btn btn-sm btn-delete" href="/Admin/Discount/Delete?id=@item.CouponId"><i class="fa fa-trash"></i> Delete</a>
									</td>
								</tr>
								i++;
							}
						}
						else
						{
							<tr>
								<td colspan="6" class="text-center">No discount coupons found.</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		</div>
	</div>
</section>