@using MultiShop.WebUI.Dtos.IdentityDtos.RoleDtos
@model AssignRoleDto

@{
    ViewData["Title"] = "Assign Roles";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<section class="content container-fluid">
    <div class="row">
        <div class="col-md-12">
            <div class="chart-box">
                <div class="page-header" style="display:flex; align-items:center; justify-content:space-between; margin-bottom:12px;">
                    <h4 style="margin:0; font-weight:600;">Assign Roles to @Model.UserFullName</h4>
                    <a asp-area="Admin" asp-controller="UserRole" asp-action="Index" class="btn btn-default" style="border-radius:16px;">Back</a>
                </div>

                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
                }
                @if (TempData["WarningMessage"] != null)
                {
                    <div class="alert alert-warning">@TempData["WarningMessage"]</div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
                }

                <form asp-area="Admin" asp-controller="UserRole" asp-action="Assign" method="post">
                    <input type="hidden" name="UserId" value="@Model.UserId" />
                    <input type="hidden" name="UserFullName" value="@Model.UserFullName" />
                    <style>
                        .role-chip{display:inline-flex;align-items:center;gap:8px;padding:8px 12px;border:1px solid rgba(0,0,0,.12);border-radius:22px;margin:6px 6px 6px 0;background:#fff;cursor:pointer;transition:.15s box-shadow,.15s transform;}
                        .role-chip input[type=checkbox]{appearance:none;-webkit-appearance:none;width:18px;height:18px;border:2px solid #6c757d;border-radius:4px;display:inline-block;position:relative;}
                        .role-chip input[type=checkbox]:checked{background:#198754;border-color:#198754;}
                        .role-chip input[type=checkbox]:checked:after{content:'\2713';position:absolute;color:#fff;font-size:14px;left:1px;top:-2px;}
                        .role-chip.active{border-color:#198754;background:#e8f5ee;}
                        .role-chip:hover{box-shadow:0 2px 10px rgba(0,0,0,.05);transform:translateY(-1px);}
                    </style>
                    <div class="row">
                        <div class="col-md-12">
                            @for (int i = 0; i < Model.Roles.Count; i++)
                            {
                                var isChecked = Model.Roles[i].IsAssigned;
                                <label class="role-chip @(isChecked ? "active" : null)">
                                    <input type="hidden" name="Roles[@i].RoleId" value="@Model.Roles[i].RoleId" />
                                    <input type="hidden" name="Roles[@i].RoleName" value="@Model.Roles[i].RoleName" />
                                    <input type="checkbox" name="Roles[@i].IsAssigned" value="true" @(isChecked ? "checked" : null) onchange="this.parentElement.classList.toggle('active', this.checked)" />
                                    <span>@Model.Roles[i].RoleName</span>
                                </label>
                            }
                        </div>
                    </div>
                    <div>
                        <button type="submit" class="btn btn-success" style="border-radius:16px;">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>


