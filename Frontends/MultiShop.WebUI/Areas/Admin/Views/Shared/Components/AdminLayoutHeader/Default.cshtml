<!-- Main Header -->
<header class="main-header dark-bg">

	<!-- Logo -->
	<a href="~/OvioAdminTemplate/html/index.html" class="logo dark-bg">
		<!-- mini logo for sidebar mini 50x50 pixels -->
		<span class="logo-mini"><img src="~/OvioAdminTemplate/html/dist/img/logo.png" alt="Ovio"></span>
		<!-- logo for regular state and mobile devices -->
		<span class="logo-lg"><img src="~/OvioAdminTemplate/html/dist/img/logo-lg.png" alt="Ovio"></span>
	</a>

	<!-- Header Navbar -->
	<nav class="navbar navbar-static-top" role="navigation">
		<!-- Sidebar toggle button-->
		<a href="#" class="sidebar-toggle" data-toggle="push-menu" role="button"> <span class="sr-only">Toggle navigation</span> </a>
		<div class="pull-left search-box">
			<form action="#" method="get" class="search-form">
				<div class="input-group">
					<input type="text" name="search" class="form-control" placeholder="Search...">
					<span class="input-group-btn">
						<button type="submit" name="search" id="search-btn" class="btn btn-flat"><i class="fa fa-search"></i> </button>
					</span>
				</div>
			</form>
			<!-- search form -->
		</div>
		<!-- Navbar Right Menu -->
		<div class="navbar-custom-menu">
			<ul class="nav navbar-nav">
				<li class="dropdown messages-menu">
					<a href="#" class="dropdown-toggle" data-toggle="dropdown">
						<i class="icon-envelope"><span class="badge" style="position:relative;top:-10px"><strong id="messageCount">@((int)(ViewBag.MessageCount ?? 0))</strong></span></i>
					</a>
					<ul class="dropdown-menu">
						<li class="header">You have <span id="headerMessageCountText">@((int)(ViewBag.MessageCount ?? 0))</span> messages</li>
						<li>
							<ul class="menu">
								@{
									var inbox = Model as System.Collections.Generic.List<MultiShop.WebUI.Dtos.MessageDtos.ResultInboxMessageDto> ?? new System.Collections.Generic.List<MultiShop.WebUI.Dtos.MessageDtos.ResultInboxMessageDto>();
								}
								@if (inbox.Count == 0)
								{
									<li class="text-center text-muted" style="padding:10px;">No messages</li>
								}
								else
								{
									foreach (var m in inbox)
									{
										<li>
											<a href="#">
												<div class="pull-left">
													<i class="fa @(m.IsRead ? "fa-check-circle text-success" : "fa-times-circle text-danger")" style="font-size:20px; margin-top:8px;"></i>
												</div>
                                                <h4>@(string.IsNullOrWhiteSpace(m.SenderName) ? (string.IsNullOrWhiteSpace(m.SenderId) ? "(Unknown)" : m.SenderId) : m.SenderName)</h4>
												<p>@(string.IsNullOrWhiteSpace(m.Subject) ? "(No Subject)" : m.Subject)</p>
												<p><small><i class="fa fa-clock-o"></i> @m.MessageDate.ToString("HH:mm")</small></p>
											</a>
										</li>
									}
								}
							</ul>
						</li>
						<li class="footer"><a asp-area="User" asp-controller="Message" asp-action="Inbox">Go to inbox</a></li>
					</ul>
				</li>
				<!-- messages-menu -->
				<!-- Notifications Menu -->
				<li class="dropdown notifications-menu">
					<a href="#" class="dropdown-toggle" data-toggle="dropdown">
						<i class="fa fa-comment"><span class="badge" style="position:relative;top:-10px"><strong id="headerCommentCount">0</strong></span></i>
					</a>
					<ul class="dropdown-menu">
						<li class="header">Comments</li>
						<li>
							<ul class="menu">
								<li class="text-center" style="padding:10px;">
									<i class="icon-bubble"></i> Total comments: <strong><span id="headerCommentCountInline">0</span></strong>
								</li>
							</ul>
						</li>
						<li class="footer"><a asp-area="Admin" asp-controller="Home" asp-action="Index">Go to dashboard</a></li>
					</ul>
				</li>
				<!-- Tasks Menu -->
				<!-- User Account Menu -->
				<li class="dropdown user user-menu">
					<a href="#" class="dropdown-toggle" data-toggle="dropdown"> <img src="~/OvioAdminTemplate/html/dist/img/img1.jpg" class="user-image" alt="User Image"> <span class="hidden-xs">Florence Douglas</span> </a>
					<ul class="dropdown-menu">
						<li class="user-header">
							<div class="pull-left user-img"><img src="~/OvioAdminTemplate/html/dist/img/img1.jpg" class="img-responsive" alt="User"></div>
							<p class="text-left">Florence Douglas <small>florence@gmail.com</small> </p>
							<div class="view-link text-left"><a href="#">View Profile</a> </div>
						</li>
						<li><a href="#"><i class="icon-profile-male"></i> My Profile</a></li>
						<li><a href="#"><i class="icon-wallet"></i> My Balance</a></li>
						<li><a href="#"><i class="icon-envelope"></i> Inbox</a></li>
						<li role="separator" class="divider"></li>
						<li><a href="#"><i class="icon-gears"></i> Account Setting</a></li>
						<li role="separator" class="divider"></li>
						<li><a href="#"><i class="fa fa-power-off"></i> Logout</a></li>
					</ul>
				</li>
			</ul>
		</div>
	</nav>
</header>

<script>
    (function(){
        var hubUrl = 'https://localhost:7085/signalrhub';
        var countEl = document.getElementById('headerMessageCount');
        var countTextEl = document.getElementById('headerMessageCountText');
        var commentEl = document.getElementById('headerCommentCount');
        var commentInlineEl = document.getElementById('headerCommentCountInline');
        var receiverId = '@(User?.FindFirst("sub")?.Value ?? "")';

        function setHeaderCount(v){
            if (countEl) { countEl.textContent = v; }
            if (countTextEl) { countTextEl.textContent = v; }
        }

        function setCommentCount(v){
            if (commentEl) { commentEl.textContent = v; }
            if (commentInlineEl) { commentInlineEl.textContent = v; }
        }

        function loadScript(src) {
            return new Promise(function (resolve, reject) {
                var s = document.createElement('script');
                s.src = src;
                s.onload = function () { resolve(); };
                s.onerror = function () { reject(new Error('Failed to load ' + src)); };
                document.head.appendChild(s);
            });
        }

        function ensureSignalR(){
            if (typeof signalR !== 'undefined') return Promise.resolve();
            var localSrc = '@Url.Content("~/microsoft/signalr/dist/browser/signalr.min.js")';
            return loadScript(localSrc).catch(function(){
                return loadScript('https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.5/signalr.min.js');
            });
        }

        ensureSignalR().then(function(){
            try {
                var connection = new signalR.HubConnectionBuilder()
                    .withUrl(hubUrl)
                    .withAutomaticReconnect()
                    .configureLogging(signalR.LogLevel.Error)
                    .build();

                connection.on('ReceiveMessageCount', function(count){ try{ console.info('Header ReceiveMessageCount', count);}catch(e){} setHeaderCount(count); });
                connection.on('ReceiveCommentCount', function(count){ try{ console.info('Header ReceiveCommentCount', count);}catch(e){} setCommentCount(count); });

                connection.start().then(function(){
                    try{ console.info('Header SignalR connected'); }catch(e){}
                    if (receiverId && receiverId.length > 0) { connection.invoke('SendStatisticCountFor', receiverId).catch(function(){}); }
                    else { connection.invoke('SendStatisticCount').catch(function(){}); }
                    setInterval(function(){
                        if (receiverId && receiverId.length > 0) { connection.invoke('SendStatisticCountFor', receiverId).catch(function(){}); }
                        else { connection.invoke('SendStatisticCount').catch(function(){}); }
                    }, 10000);
                }).catch(function(){});
            } catch (e) { }
        }).catch(function(){});
    })();
</script>