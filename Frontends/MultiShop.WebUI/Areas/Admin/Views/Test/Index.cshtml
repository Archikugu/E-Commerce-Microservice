
@{
    ViewData["Title"] = "Index";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h1>SignalR Test</h1>

<div class="row">
    <div class="col-md-6">
        <div class="panel panel-default">
            <div class="panel-heading">Live Statistics <span id="hubStatus" class="label label-warning" style="margin-left:8px;">Bağlanıyor...</span></div>
            <div class="panel-body">
                <p>
                    <strong>Total Comments: </strong>
                    <span id="commentCount">-</span>
                </p>
                <p>
                    <strong>My Message Count: </strong>
                    <span id="messageCount">-</span>
                </p>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="alert alert-info">
            Hub bağlantısı kurulduğunda değerler otomatik güncellenecektir.
        </div>
    </div>
    
</div>
<script>
    (function () {
        function loadScript(src) {
            return new Promise(function (resolve, reject) {
                var s = document.createElement('script');
                s.src = src;
                s.onload = function () { resolve(); };
                s.onerror = function () { reject(new Error('Failed to load ' + src)); };
                document.head.appendChild(s);
            });
        }

        // Önce local, sonra CDN fallback
        var localSrc = '@Url.Content("~/microsoft/signalr/dist/browser/signalr.min.js")';
        var cdn906 = 'https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/9.0.6/signalr.min.js';
        var cdn805 = 'https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.5/signalr.min.js';

        window.signalrLoader = loadScript(localSrc)
            .catch(function(){ return loadScript(cdn906); })
            .catch(function(){ return loadScript(cdn805); });
    })();
</script>
<script>
    (function () {
        const commentEl = document.getElementById('commentCount');
        const messageEl = document.getElementById('messageCount');
        const hubStatus = document.getElementById('hubStatus');

        // SignalR Hub URL - SignalR servisin launchSettings'ine göre ayarlı
        const hubUrl = 'https://localhost:7085/signalrhub';

        let connection = null;
        function buildConnection() {
            connection = new signalR.HubConnectionBuilder()
                .withUrl(hubUrl)
                .withAutomaticReconnect()
                .configureLogging(signalR.LogLevel.Information)
                .build();

            connection.on('ReceiveCommentCount', function (count) {
                if (commentEl) commentEl.textContent = count;
            });

            connection.on('ReceiveMessageCount', function (count) {
                if (messageEl) messageEl.textContent = count;
            });

            connection.onreconnecting(function () {
                setStatus('Yeniden bağlanıyor...', 'label label-warning');
            });

            connection.onreconnected(function () {
                setStatus('Bağlandı', 'label label-success');
            });

            connection.onclose(function () {
                setStatus('Bağlı değil', 'label label-danger');
                setTimeout(start, 2000);
            });
        }

        function setStatus(text, cls) {
            if (!hubStatus) return;
            hubStatus.textContent = text;
            hubStatus.className = cls;
        }

        async function start() {
            try {
                if (window.signalrLoader && typeof signalR === 'undefined') {
                    try { await window.signalrLoader; } catch (e) { }
                }
                if (typeof signalR === 'undefined') {
                    setStatus('SignalR kütüphanesi yüklenemedi', 'label label-danger');
                    try { console.error('SignalR script could not be loaded'); } catch (e) { }
                    return;
                }
                // negotiate testi: olası CORS/404/SSL sorunlarını erken yakala
                try {
                    const res = await fetch(hubUrl + '/negotiate?negotiateVersion=1', { method: 'POST', headers: { 'Content-Type': 'application/json' } });
                    if (!res.ok) {
                        setStatus('Bağlı değil', 'label label-danger');
                        try { console.error('Negotiate failed:', res.status, res.statusText); } catch (e) { }
                    }
                } catch (ne) {
                    setStatus('Bağlı değil', 'label label-danger');
                    try { console.error('Negotiate error:', ne); } catch (e) { }
                }
                if (!connection) {
                    buildConnection();
                }
                await connection.start();
                setStatus('Bağlandı', 'label label-success');
                // İlk değerleri iste (kullanıcıya özel)
                var receiverId = '@(User?.FindFirst("sub")?.Value ?? "")';
                if (receiverId && receiverId.length > 0) {
                    await connection.invoke('SendStatisticCountFor', receiverId);
                } else {
                    await connection.invoke('SendStatisticCount');
                }
                // Periyodik güncelleme (5 sn)
                setInterval(function () {
                    var receiverId = '@(User?.FindFirst("sub")?.Value ?? "")';
                    var method = (receiverId && receiverId.length > 0) ? 'SendStatisticCountFor' : 'SendStatisticCount';
                    var args = (method === 'SendStatisticCountFor') ? [receiverId] : [];
                    connection.invoke(method, ...args).catch(function () { /* ignore */ });
                }, 5000);
            } catch (err) {
                // Tekrar dene
                setStatus('Bağlı değil', 'label label-danger');
                try { console.error('SignalR start error:', err); } catch (e) { }
                setTimeout(start, 2000);
            }
        }

        start();
    })();
</script>

