@model List<MultiShop.WebUI.Dtos.CatalogDtos.ProductDtos.ResultProductsWithCategoryDto>
@{
    ViewData["Title"] = "Stock Management";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    int count = 0;
}

<section class="content container-fluid">
    <div class="row">
        <div class="col-md-12">
            <div class="chart-box" style="border-radius:8px; border:1px solid rgba(0,0,0,.08); overflow:hidden;">
                <style>
                    .chart-box{ border-radius:8px; border:1px solid rgba(0,0,0,.08); overflow:hidden; }
                    .items-per-page-select{ display:inline-block; width:auto; padding:4px 10px; height:32px; line-height:20px; border:1px solid rgba(0,0,0,.15); border-radius:16px; background-color:#fff; color:#212529; }
                    .items-per-page-label{ font-size:12px; }
                    .table > thead > tr > th,
                    .table > tbody > tr > th,
                    .table > tbody > tr > td { vertical-align: middle; }
                </style>
                <div class="clearfix" style="display:flex; align-items:center; justify-content:space-between; margin-bottom:12px; padding:16px 16px 0 16px;">
                    <h3 style="margin:0; font-weight:600;">Stock Management</h3>
                    <form method="get" style="margin-left:auto; display:flex; align-items:center; gap:6px;">
                        <input type="hidden" name="pageNumber" value="1" />
                        @{
                            int curSize = (int)(ViewBag.PageSize ?? 10);
                        }
                        <label class="text-muted items-per-page-label" style="margin:0;">Items per page</label>
                        <select name="pageSize" class="form-control items-per-page-select" onchange="this.form.submit()">
                            <option value="5" selected="@(curSize==5 ? "selected" : null)">5</option>
                            <option value="10" selected="@(curSize==10 ? "selected" : null)">10</option>
                            <option value="25" selected="@(curSize==25 ? "selected" : null)">25</option>
                            <option value="50" selected="@(curSize==50 ? "selected" : null)">50</option>
                            <option value="100" selected="@(curSize==100 ? "selected" : null)">100</option>
                        </select>
                    </form>
                </div>
                <div class="bs-example" data-example-id="simple-table">
                    <table class="table table-striped table-hover" style="margin-bottom:0;">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Product</th>
                                <th>Category</th>
                                <th>Price</th>
                                <th>Stock</th>
                                <th>Min Stock</th>
                                <th>Max Stock</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in Model)
                            {
                                count++;
                                var status = "Unknown";
                                var labelClass = "label-default";
                                if (p.StockQuantity <= p.MinStock) { status = "Low"; labelClass = "label-danger"; }
                                else if (p.MaxStock > 0 && p.StockQuantity > p.MaxStock) { status = "Over"; labelClass = "label-warning"; }
                                else { status = "OK"; labelClass = "label-success"; }
                                <tr>
                                    <td>@count</td>
                                    <td>@p.ProductName</td>
                                    <td>@p.Category?.CategoryName</td>
                                    <td>@p.Price.ToString("C")</td>
                                    <td>@p.StockQuantity</td>
                                    <td>@p.MinStock</td>
                                    <td>@p.MaxStock</td>
                                    <td><span class="label @labelClass">@status</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div style="text-align:center; margin-top:16px;">
                    <nav aria-label="Stock pagination" style="display:inline-block;">
                        <ul class="pagination pagination-sm" style="margin:0; display:inline-flex;">
                            @{
                                int pageNumber = (int)(ViewBag.PageNumber ?? 1);
                                int pageSize = (int)(ViewBag.PageSize ?? 10);
                                int totalItems = (int)(ViewBag.TotalItems ?? 0);
                                int totalPages = Math.Max(1, (int)Math.Ceiling((double)totalItems / Math.Max(1, pageSize)));
                                int prev = Math.Max(1, pageNumber - 1);
                                int next = Math.Min(totalPages, pageNumber + 1);
                                int start = Math.Max(1, pageNumber - 2);
                                int end = Math.Min(totalPages, start + 4);
                            }
                            <li class="@(pageNumber == 1 ? "disabled" : null)"><a asp-area="Admin" asp-controller="Stock" asp-action="Index" asp-route-pageNumber="1" asp-route-pageSize="@pageSize">First</a></li>
                            <li class="@(pageNumber == 1 ? "disabled" : null)"><a asp-area="Admin" asp-controller="Stock" asp-action="Index" asp-route-pageNumber="@prev" asp-route-pageSize="@pageSize">Prev</a></li>
                            @for (int i = start; i <= end; i++)
                            {
                                <li class="@(i == pageNumber ? "active" : null)"><a asp-area="Admin" asp-controller="Stock" asp-action="Index" asp-route-pageNumber="@i" asp-route-pageSize="@pageSize">@i</a></li>
                            }
                            <li class="@(pageNumber == totalPages ? "disabled" : null)"><a asp-area="Admin" asp-controller="Stock" asp-action="Index" asp-route-pageNumber="@next" asp-route-pageSize="@pageSize">Next</a></li>
                            <li class="@(pageNumber == totalPages ? "disabled" : null)"><a asp-area="Admin" asp-controller="Stock" asp-action="Index" asp-route-pageNumber="@totalPages" asp-route-pageSize="@pageSize">Last</a></li>
                        </ul>
                    </nav>
                </div>
            </div>
        </div>
    </div>
</section>


