@model List<ResultSpecialOfferDto>
@{
	ViewData["Title"] = "Special Offer Management";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<section class="content container-fluid">
    <div class="row">
        <div class="col-md-12">
            <div class="chart-box">
                <style>
                    .chart-box{ border-radius:8px; border:1px solid rgba(0,0,0,.08); overflow:hidden; }
                    .page-header { display:flex; align-items:center; justify-content:space-between; margin:0 0 12px 0; }
                    .page-header h4 { margin:0; font-weight:600; }
                    .table .btn { border-radius:16px; padding:6px 10px; }
                    .btn-update{ background:#ffc107; border-color:#ffc107; color:#212529; }
                    .btn-delete{ background:#dc3545; border-color:#dc3545; color:#fff; }
                    .btn-add{ background:#198754; border-color:#198754; color:#fff; border-radius:20px; padding:8px 14px; transition:all .15s ease; box-shadow:0 2px 6px rgba(25,135,84,.18); }
                    .btn-add:hover{ background:#157347; border-color:#157347; color:#fff; box-shadow:0 6px 16px rgba(25,135,84,.35); transform: translateY(-1px); text-decoration:none; }
                    .offer-thumb{ width:80px; height:60px; object-fit:cover; border-radius:6px; border:1px solid rgba(0,0,0,.05); }
                    .table > thead > tr > th,
                    .table > tbody > tr > th,
                    .table > tbody > tr > td { vertical-align: middle; }
                </style>
                <div class="page-header">
                    <h4>Special Offers</h4>
                    <a asp-area="Admin" asp-controller="SpecialOffer" asp-action="CreateSpecialOffer" class="btn btn-add"><i class="fa fa-plus" style="margin-right:8px;"></i> Add New Special Offer</a>
                </div>

                <div class="bs-example" data-example-id="simple-table">
                    <table class="table table-striped table-hover">
						<thead>
							<tr>
								<th>Image</th>
								<th>SpecialOffer Title</th>
								<th>SpecialOffer SubTitle</th>
								<th>Delete</th>
								<th>Update</th>
							</tr>
						</thead>
						<tbody>
							@foreach (var item in Model)
							{
								<tr>
									<td>
										@if (!string.IsNullOrEmpty(item.ImageUrl))
										{
                                            <img src="@item.ImageUrl" alt="@item.Title" class="offer-thumb" />
										}
										else
										{
											<span class="text-muted">No Image</span>
										}
									</td>
									<td>@item.Title</td>
									<td>@item.SubTitle</td>
                                    <td><a asp-area="Admin" asp-controller="SpecialOffer" asp-action="DeleteSpecialOffer" asp-route-id="@item.SpecialOfferId" class="btn btn-delete btn-sm"><i class="fa fa-trash"></i> Delete</a></td>
                                    <td><a asp-area="Admin" asp-controller="SpecialOffer" asp-action="UpdateSpecialOffer" asp-route-id="@item.SpecialOfferId" class="btn btn-update btn-sm"><i class="fa fa-edit"></i> Update</a></td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			</div>
		</div>
	</div>
</section>


