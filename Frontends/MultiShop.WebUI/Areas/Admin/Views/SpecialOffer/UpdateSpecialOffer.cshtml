@model UpdateSpecialOfferDto

@{
	ViewData["Title"] = "UpdateSpecialOffer";
	Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<section class="content container-fluid">
	<div class="row">

		<div class="col-md-12">
			<div class="chart-box">
				<style>
					.chart-box{ border-radius:8px; border:1px solid rgba(0,0,0,.08); overflow:hidden; }
					.page-header { display:flex; align-items:center; justify-content:space-between; margin:0 0 12px 0; }
					.page-header h4 { margin:0; font-weight:600; }
					.form-group{ margin-bottom:12px; }
					.form-control{ border-radius:8px; border:1px solid rgba(0,0,0,.15); box-shadow:none; }
					.form-control:focus{ border-color:#0d6efd; box-shadow:0 0 0 .1rem rgba(13,110,253,.15); }
					.btn-update{ background:#ffc107; border-color:#ffc107; color:#212529; border-radius:20px; padding:8px 14px; transition:all .15s ease; box-shadow:0 2px 6px rgba(255,193,7,.18); }
					.btn-update:hover{ background:#e0a800; border-color:#e0a800; color:#212529; box-shadow:0 6px 16px rgba(255,193,7,.35); transform: translateY(-1px); text-decoration:none; }
					.btn-cancel{ border-radius:20px; padding:8px 14px; }
					.custom-file{ display:flex; align-items:center; gap:8px; }
					.btn-upload{ border-radius:20px; padding:8px 14px; border:1px solid #0d6efd; color:#0d6efd; background:#fff; box-shadow:0 1px 2px rgba(13,110,253,.08); }
					.btn-upload:hover{ background:#0d6efd; color:#fff; box-shadow:0 4px 12px rgba(13,110,253,.3); }
					.file-name{ font-size:13px; color:#6c757d; }
					.preview-wrap{ margin-top:8px; }
					.preview-img{ display:@(string.IsNullOrWhiteSpace(Model?.ImageUrl) ? "none" : "inline-block"); width:240px; height:120px; object-fit:cover; border-radius:8px; border:1px solid rgba(0,0,0,.1); box-shadow:0 2px 6px rgba(0,0,0,.06); }
				</style>

				<div class="page-header">
					<h4>Update Special Offer</h4>
					<a asp-area="Admin" asp-controller="SpecialOffer" asp-action="Index" class="btn btn-default btn-cancel"><i class="fa fa-arrow-left"></i> Back</a>
				</div>

				<div class="bs-example" data-example-id="bordered-table">
					@Html.ValidationSummary(false, "", new { @class = "text-danger" })
					<form method="post" id="soUpdateForm">
						@Html.AntiForgeryToken()
						<input type="hidden" asp-for="SpecialOfferId" />
						<div class="form-group">
							<label>Special Offer Title</label>
							<input type="text" class="form-control" asp-for="Title" placeholder="e.g. Big Winter Sale" />
							<span asp-validation-for="Title" class="text-danger"></span>
						</div>
						<div class="form-group">
							<label>Special Offer SubTitle</label>
							<input type="text" class="form-control" asp-for="SubTitle" placeholder="Subtitle" />
							<span asp-validation-for="SubTitle" class="text-danger"></span>
						</div>
						<div class="form-group">
							<label>Special Offer Image</label>
							<input type="hidden" asp-for="ImageUrl" />
							<div class="custom-file">
								<input type="file" id="soUpdateImageFile" accept="image/*" style="display:none;" />
								<label for="soUpdateImageFile" class="btn btn-default btn-upload"><i class="fa fa-upload" style="margin-right:6px;"></i> Choose Image</label>
								<span id="soUpdateFileNameText" class="file-name">@((string.IsNullOrWhiteSpace(Model?.ImageUrl) ? "No file chosen" : System.IO.Path.GetFileName(Model.ImageUrl)))</span>
							</div>
							<div class="preview-wrap">
								<img id="soUpdateImagePreview" class="preview-img" alt="Preview" src="@Model?.ImageUrl" />
							</div>
							<span asp-validation-for="ImageUrl" class="text-danger"></span>
						</div>

						<div id="soUpdateUploadError" class="alert alert-danger" style="display:none; margin-top:8px;"></div>

						<div style="display:flex; align-items:center; gap:8px;">
							<button type="button" id="soUpdateSubmitBtn" class="btn btn-update"><i class="fa fa-save" style="margin-right:8px;"></i> Update Special Offer</button>
							<a asp-area="Admin" asp-controller="SpecialOffer" asp-action="Index" class="btn btn-default btn-cancel">Cancel</a>
						</div>
					</form>

					<script>
						(function(){
							var btn = document.getElementById('soUpdateSubmitBtn');
							var fileInput = document.getElementById('soUpdateImageFile');
							var formEl = document.getElementById('soUpdateForm');
							var fileNameText = document.getElementById('soUpdateFileNameText');
							var previewImg = document.getElementById('soUpdateImagePreview');
							if (fileInput && fileNameText){
								fileInput.addEventListener('change', function(){
									var f = (fileInput.files && fileInput.files[0]) ? fileInput.files[0] : null;
									fileNameText.textContent = f ? f.name : 'No file chosen';
									if (previewImg){
										if (f){ previewImg.src = URL.createObjectURL(f); previewImg.style.display = 'inline-block'; }
										else if (!('@Model?.ImageUrl' && '@Model?.ImageUrl'.length>0)) { previewImg.removeAttribute('src'); previewImg.style.display = 'none'; }
									}
								});
							}
							if(!btn || !formEl) return;
							btn.addEventListener('click', function(){
								var errBox = document.getElementById('soUpdateUploadError');
								if (errBox) { errBox.style.display = 'none'; errBox.textContent = ''; }
								var file = fileInput && fileInput.files && fileInput.files[0];
								if(!file){ formEl.submit(); return; }
								btn.disabled = true; var originalText = btn.innerHTML; btn.innerHTML = '<i class="fa fa-spinner fa-spin"></i> Uploading...';
								var data = new FormData();
								data.append('file', file);
								fetch('/Admin/SpecialOffer/UploadImage', { method:'POST', body:data })
									.then(function(r){ return r.ok ? r.json() : r.text().then(function(t){ throw new Error(t || ('HTTP '+r.status)); }); })
									.then(function(res){
										var p = Promise.resolve(null);
										if (res && res.fileName){
											p = fetch('/Admin/SpecialOffer/GetSignedUrl?fileName='+encodeURIComponent(res.fileName)+'&minutes=10080')
												.then(function(r){ return r.ok ? r.json() : null; })
												.catch(function(){ return null; });
										}
										return p.then(function(signed){
											var imageInput = document.querySelector('input[name="ImageUrl"]');
											if (imageInput){
												if (signed && signed.signedUrl){ imageInput.value = signed.signedUrl; }
												else if(res && res.url){ imageInput.value = res.url; }
											}
											formEl.submit();
										});
									})
									.catch(function(e){
										if (errBox) { errBox.textContent = 'Image upload failed. '+ (e && e.message ? e.message : ''); errBox.style.display = 'block'; }
										btn.disabled = false; btn.innerHTML = originalText;
									});
							});
						})();
					</script>
				</div>
			</div>
		</div>
	</div>
</section>


