@using MultiShop.WebUI.Dtos.CatalogDtos.ProductDetailDtos
@model GetByIdProductDetailDto
@{
    ViewData["Title"] = "GetByIdProductDetail";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<section class="content container-fluid">
    <div class="row">
        <div class="col-md-12">
            <div class="chart-box">
                <style>
                    .chart-box{ border-radius:8px; border:1px solid rgba(0,0,0,.08); overflow:hidden; }
                    .page-header { display:flex; align-items:center; justify-content:space-between; margin:0 0 12px 0; }
                    .page-header h4 { margin:0; font-weight:600; }
                    .btn-cancel{ border-radius:20px; padding:8px 14px; }
                </style>
                <div class="page-header">
                    <h4>Product Detail Information</h4>
                    <div>
                        <a asp-area="Admin" asp-controller="ProductDetail" asp-action="Index" class="btn btn-default btn-cancel"><i class="fa fa-arrow-left"></i> Back</a>
                    </div>
                </div>
                <div class="bs-example" data-example-id="bordered-table">
                    <table class="table table-bordered">
                        <tbody>
                            <tr>
                                <th>Product Detail ID</th>
                                <td>@Model.ProductDetailId</td>
                            </tr>
                            <tr>
                                <th>Description</th>
                                <td>@Model.Description</td>
                            </tr>
                            <tr>
                                <th>Info</th>
                                <td>@Model.Info</td>
                            </tr>
                            <tr>
                                <th>Product ID</th>
                                <td>@Model.ProductId</td>
                            </tr>
                        </tbody>
                    </table>

                    <div class="form-group" style="display:flex; align-items:center; gap:8px;">
                        <a asp-area="Admin" asp-controller="ProductDetail" asp-action="UpdateProductDetail" asp-route-id="@Model.ProductDetailId" class="btn btn-warning" style="border-radius:20px;"><i class="fa fa-edit"></i> Update</a>
                        <a asp-area="Admin" asp-controller="ProductDetail" asp-action="Index" class="btn btn-default btn-cancel">Back to List</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
