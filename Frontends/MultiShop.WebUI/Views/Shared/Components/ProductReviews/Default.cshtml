@using MultiShop.WebUI.Dtos.CommentDtos
@model List<ResultCommentDto>
@{
    var pid = (string)(ViewBag.ProductId ?? "");
}
<div class="tab-pane fade" id="tab-pane-3">
    <div class="row">
        <div class="col-md-6">
            <h4 class="mb-4">Reviews</h4>
            @if (Model != null && Model.Any())
            {
                foreach (var c in Model.OrderByDescending(x => x.Rating))
                {
                    <div style="border-bottom:1px solid #e5e7eb; padding:10px 0;">
                        <strong>@c.FirstName @c.LastName</strong>
                        <span class="text-muted" style="font-size:12px;">(@c.Email)</span>
                        <div style="color:#f59e0b;">
                            @for(int i=0;i<Math.Max(0,Math.Min(5,c.Rating));i++){<i class="fa fa-star"></i>}
                        </div>
                        <div>@c.CommentDetail</div>
                    </div>
                }
            }
            else
            {
                <p class="text-muted">No reviews yet.</p>
            }
        </div>
        <div class="col-md-6">
            <h4 class="mb-4">Leave a review</h4>
            <form asp-area="User" asp-controller="Reviews" asp-action="Create" method="post">
                <input type="hidden" name="ProductId" value="@pid" />
                <div class="form-group">
                    <label>Rating</label>
                    <select name="Rating" class="form-control" required>
                        <option value="5">★★★★★</option>
                        <option value="4">★★★★☆</option>
                        <option value="3">★★★☆☆</option>
                        <option value="2">★★☆☆☆</option>
                        <option value="1">★☆☆☆☆</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>Comment</label>
                    <textarea name="CommentDetail" class="form-control" rows="4" required></textarea>
                </div>
                <button type="submit" class="btn btn-primary"><i class="fa fa-paper-plane"></i> Submit</button>
            </form>
        </div>
    </div>
</div>


