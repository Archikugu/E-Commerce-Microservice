@model List<MultiShop.WebUI.Dtos.DiscountDtos.DiscountCouponDtos.ResultDiscountCouponDto>
@{
    ViewData["Title"] = "Discounts & Coupons";
}

<div class="row">
    <div class="col-12 grid-margin">
        <div class="card">
            <div class="card-body">
                <h4 class="card-title">Available Coupons</h4>

                <div class="mb-3">
                    <form asp-controller="Discount" asp-action="ConfirmDiscountCode" method="post" class="form-inline">
                        <div class="input-group">
                            <input type="text" name="code" class="form-control" placeholder="Enter coupon code" required />
                            <div class="input-group-append">
                                <button type="submit" class="btn btn-primary">Apply</button>
                            </div>
                        </div>
                    </form>
                </div>

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
                }
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
                }

                <div class="table-responsive">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Code</th>
                                <th>Rate</th>
                                <th>Valid Until</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var c in Model)
                            {
                                <tr>
                                    <td><span class="badge badge-info">@c.Code</span></td>
                                    <td>@c.Rate %</td>
                                    <td>@c.ValidDate.ToString("yyyy-MM-dd")</td>
                                    <td>
                                        <form asp-controller="Discount" asp-action="ConfirmDiscountCode" method="post" class="d-inline">
                                            <input type="hidden" name="code" value="@c.Code" />
                                            <button type="submit" class="btn btn-sm btn-success">Apply</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-muted">No active coupons found.</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>


